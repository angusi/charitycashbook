{% extends "layouts/charity.html.twig" %}

{% block title %}Edit Gift Aid Claim - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Edit Gift Aid Claim</h1>
    <p class="text-sm text-gray-500">{{ charity.name }}</p>
</div>

{% include 'components/flash.html.twig' %}

<form method="post" action="/charity/{{ charity.id }}/giftaid/claims/{{ claim.id }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    
    <!-- Claim Period -->
    <div class="bg-white rounded-lg shadow mb-6 p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Claim Period</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label for="period_start" class="block text-sm font-medium text-gray-700">Start Date</label>
                <input type="date" name="period_start" id="period_start" required
                       value="{{ claim.claim_period_start }}"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            </div>
            <div>
                <label for="period_end" class="block text-sm font-medium text-gray-700">End Date</label>
                <input type="date" name="period_end" id="period_end" required 
                       value="{{ claim.claim_period_end }}"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            </div>
        </div>
    </div>

    <!-- Standard Donations -->
    {% if standard_donations|length > 0 %}
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Standard Gift Aid Donations</h2>
            <p class="text-sm text-gray-500">{{ standard_donations|length }} transactions available</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left">
                            <input type="checkbox" id="select_all_standard"
                                   class="rounded border-gray-300 text-blue-600"
                                   onchange="toggleAll('standard', this.checked)">
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Donor</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Gift Aid</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for t in standard_donations %}
                    <tr class="{{ t.in_claim ? 'bg-blue-50' : '' }}">
                        <td class="px-6 py-4">
                            <input type="checkbox" name="transactions[]" value="{{ t.id }}" 
                                   {{ t.in_claim ? 'checked' : '' }}
                                   class="standard-checkbox rounded border-gray-300 text-blue-600">
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ t.transaction_date }}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ t.description }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ t.donor_name ?: 'One-off' }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900">£{{ t.amount|number_format(2) }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-green-600">£{{ (t.amount * 0.25)|number_format(2) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    <!-- GASDS Donations -->
    {% if gasds_donations|length > 0 %}
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">GASDS Donations</h2>
            <p class="text-sm text-gray-500">{{ gasds_donations|length }} small cash donations available</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left">
                            <input type="checkbox" id="select_all_gasds"
                                   class="rounded border-gray-300 text-purple-600"
                                   onchange="toggleAll('gasds', this.checked)">
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Gift Aid</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for t in gasds_donations %}
                    <tr class="{{ t.in_claim ? 'bg-purple-50' : '' }}">
                        <td class="px-6 py-4">
                            <input type="checkbox" name="transactions[]" value="{{ t.id }}"
                                   {{ t.in_claim ? 'checked' : '' }}
                                   class="gasds-checkbox rounded border-gray-300 text-purple-600">
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ t.transaction_date }}</td>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ t.description }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900">£{{ t.amount|number_format(2) }}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-purple-600">£{{ (t.amount * 0.25)|number_format(2) }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    <!-- Summary & Submit -->
    <div class="bg-white rounded-lg shadow p-6">
        <div class="flex justify-between items-center">
            <div>
                <p class="text-sm text-gray-500">Current claim total</p>
                <p class="text-2xl font-semibold text-green-600">£{{ claim.total_giftaid|number_format(2) }}</p>
                <p class="text-xs text-gray-400 mt-1">Will recalculate on save</p>
            </div>
            <div class="space-x-3">
                <a href="/charity/{{ charity.id }}/giftaid/claims/{{ claim.id }}" 
                   class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</form>
{% endblock %}

{% block scripts %}
<script>
function toggleAll(type, checked) {
    document.querySelectorAll('.' + type + '-checkbox').forEach(function(cb) {
        cb.checked = checked;
    });
}

// Update select-all checkboxes based on current state
document.addEventListener('DOMContentLoaded', function() {
    ['standard', 'gasds'].forEach(function(type) {
        var checkboxes = document.querySelectorAll('.' + type + '-checkbox');
        var selectAll = document.getElementById('select_all_' + type);
        if (selectAll && checkboxes.length > 0) {
            var allChecked = Array.from(checkboxes).every(cb => cb.checked);
            selectAll.checked = allChecked;
        }
    });
});
</script>
{% endblock %}
