{% extends "layouts/base.html.twig" %}

{% block title %}Pending Approval - {{ charity.name }}{% endblock %}

{% block content %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <h2 class="text-center text-3xl font-bold text-gray-900">
            Awaiting Approval
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
            {{ charity.name }}
        </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
            <div class="text-center">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100 mb-4">
                    <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                
                <h3 class="text-lg font-medium text-gray-900 mb-2">
                    Your access request is pending
                </h3>
                
                <p class="text-sm text-gray-500 mb-6">
                    An administrator of <strong>{{ charity.name }}</strong> needs to approve your access 
                    before you can use this charity's cashbook.
                </p>
                
                <p class="text-sm text-gray-500 mb-6">
                    You will be able to access the charity once an administrator has reviewed and 
                    approved your request. They may contact you at your registered email address.
                </p>
                
                <div class="border-t border-gray-200 pt-6">
                    <a href="/charities" 
                       class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                        &larr; Back to Charities
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
