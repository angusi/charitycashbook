{% extends "layouts/charity.html.twig" %}

{% block title %}Roles - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Roles</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>
    <a href="/charity/{{ charity.id }}/settings/roles/create" 
       class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
        + New Role
    </a>
</div>

{% include 'components/flash.html.twig' %}

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Settings Navigation -->
    <div class="lg:col-span-1">
        <nav class="space-y-1">
            <a href="/charity/{{ charity.id }}/settings" 
               class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                General
            </a>
            <a href="/charity/{{ charity.id }}/settings/modules" 
               class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                Modules
            </a>
            <a href="/charity/{{ charity.id }}/settings/users" 
               class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                Users
            </a>
            <a href="/charity/{{ charity.id }}/settings/roles" 
               class="bg-blue-50 text-blue-700 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                Roles
            </a>
            <a href="/charity/{{ charity.id }}/settings/allowed-emails" 
               class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                Allowed Emails
            </a>
            <a href="/charity/{{ charity.id }}/settings/audit" 
               class="text-gray-600 hover:bg-gray-50 hover:text-gray-900 group flex items-center px-3 py-2 text-sm font-medium rounded-md">
                Audit Log
            </a>
        </nav>
    </div>

    <!-- Roles List -->
    <div class="lg:col-span-3">
        <div class="bg-white rounded-lg shadow overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Users</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Permissions</th>
                        <th class="px-6 py-3"></th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for role in roles %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    {% set colour = role.colour|default('gray') %}
                                    <span class="inline-block h-3 w-3 rounded-full flex-shrink-0
                                        {% if colour == 'red' %}bg-red-500
                                        {% elseif colour == 'orange' %}bg-orange-500
                                        {% elseif colour == 'amber' %}bg-amber-500
                                        {% elseif colour == 'yellow' %}bg-yellow-500
                                        {% elseif colour == 'lime' %}bg-lime-500
                                        {% elseif colour == 'green' %}bg-green-500
                                        {% elseif colour == 'emerald' %}bg-emerald-500
                                        {% elseif colour == 'teal' %}bg-teal-500
                                        {% elseif colour == 'cyan' %}bg-cyan-500
                                        {% elseif colour == 'sky' %}bg-sky-500
                                        {% elseif colour == 'blue' %}bg-blue-500
                                        {% elseif colour == 'indigo' %}bg-indigo-500
                                        {% elseif colour == 'violet' %}bg-violet-500
                                        {% elseif colour == 'purple' %}bg-purple-500
                                        {% elseif colour == 'fuchsia' %}bg-fuchsia-500
                                        {% elseif colour == 'pink' %}bg-pink-500
                                        {% elseif colour == 'rose' %}bg-rose-500
                                        {% else %}bg-gray-500
                                        {% endif %}"></span>
                                    <div>
                                        <div class="text-sm font-medium text-gray-900">{{ role.display_name }}</div>
                                        <div class="text-sm text-gray-500">{{ role.name }}</div>
                                    </div>
                                </div>
                                {% if role.description %}
                                    <div class="text-xs text-gray-400 mt-1 ml-5">{{ role.description }}</div>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                    {{ role.user_count }} user{{ role.user_count != 1 ? 's' : '' }}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-500">
                                    {% if role.name == 'pending' %}
                                        <span class="text-gray-400">No permissions</span>
                                    {% elseif role.permissions|length == permission_definitions|length %}
                                        <span class="text-green-600">All permissions</span>
                                    {% else %}
                                        {{ role.permissions|length }} of {{ permission_definitions|length }}
                                    {% endif %}
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                {% if role.name != 'pending' %}
                                    <a href="/charity/{{ charity.id }}/settings/roles/{{ role.id }}/edit" 
                                       class="text-blue-600 hover:text-blue-900">Edit</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-6 bg-gray-50 rounded-lg p-4 border border-gray-200">
            <h3 class="text-sm font-medium text-gray-900 mb-2">About Roles</h3>
            <ul class="text-sm text-gray-500 space-y-1">
                <li>• <strong>Pending</strong> users have no access until approved by an admin</li>
                <li>• <strong>Admin</strong> role always has full access and cannot have permissions removed</li>
                <li>• You can create custom roles with any combination of permissions</li>
                <li>• Deleting a role will reassign its users to another role</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}
