{% extends "layouts/charity.html.twig" %}

{% block title %}Generate Membership Dues - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
        <a href="/charity/{{ charity.id }}/members" class="hover:text-gray-700">Members</a>
        <span>›</span>
        <a href="/charity/{{ charity.id }}/members/dues" class="hover:text-gray-700">Dues</a>
        <span>›</span>
        <span>Generate</span>
    </div>
    <h1 class="text-2xl font-bold text-gray-900">Generate Membership Dues</h1>
    <p class="text-sm text-gray-500">Create dues records for all active members</p>
</div>

{% include 'components/flash.html.twig' %}

<div class="max-w-lg">
    <form method="post" action="/charity/{{ charity.id }}/members/dues/generate">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <div class="bg-white rounded-lg shadow p-6 space-y-4">
            <div class="bg-blue-50 border border-blue-200 rounded-md p-4 mb-4">
                <h3 class="text-sm font-medium text-blue-800">What this does</h3>
                <p class="mt-1 text-sm text-blue-700">
                    This will create dues records for all <strong>{{ statistics.total_members }}</strong> active members 
                    who don't already have a dues record for the specified period.
                </p>
            </div>

            <div>
                <label for="period_label" class="block text-sm font-medium text-gray-700">Period Label *</label>
                <input type="text" name="period_label" id="period_label" required maxlength="50"
                       value="{{ default_period.period_label }}"
                       placeholder="e.g. 2026, 2026-2027"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                <p class="mt-1 text-xs text-gray-500">This is shown to members and on reports</p>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="period_start" class="block text-sm font-medium text-gray-700">Period Start *</label>
                    <input type="date" name="period_start" id="period_start" required
                           value="{{ default_period.period_start }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
                <div>
                    <label for="period_end" class="block text-sm font-medium text-gray-700">Period End *</label>
                    <input type="date" name="period_end" id="period_end" required
                           value="{{ default_period.period_end }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Fee Amount</label>
                <div class="space-y-2">
                    <label class="flex items-center">
                        <input type="radio" name="fee_source" value="type" checked
                               onchange="document.getElementById('custom_fee_row').style.display = 'none'"
                               class="rounded-full border-gray-300 text-blue-600 focus:ring-blue-500">
                        <span class="ml-2 text-sm text-gray-700">Use fee from each member's membership type</span>
                    </label>
                    <label class="flex items-center">
                        <input type="radio" name="fee_source" value="custom"
                               onchange="document.getElementById('custom_fee_row').style.display = 'block'"
                               class="rounded-full border-gray-300 text-blue-600 focus:ring-blue-500">
                        <span class="ml-2 text-sm text-gray-700">Use custom amount for all members</span>
                    </label>
                </div>
                <div id="custom_fee_row" style="display: none;" class="mt-3">
                    <label for="amount_due" class="block text-sm font-medium text-gray-700">Custom Fee (£)</label>
                    <input type="number" name="amount_due" id="amount_due" step="0.01" min="0"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
            </div>

            <div class="bg-gray-50 rounded-md p-4">
                <h4 class="text-sm font-medium text-gray-700 mb-2">Membership Types</h4>
                <div class="space-y-1 text-sm text-gray-600">
                    {% for type in membership_types %}
                        <div class="flex justify-between">
                            <span>{{ type.name }}</span>
                            <span>£{{ type.annual_fee|number_format(2) }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="mt-6 flex justify-end space-x-3">
            <a href="/charity/{{ charity.id }}/members/dues" 
               class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                Cancel
            </a>
            <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                Generate Dues
            </button>
        </div>
    </form>
</div>
{% endblock %}
