{% extends "layouts/charity.html.twig" %}

{% block title %}Membership Types - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Membership Types</h1>
    <p class="text-sm text-gray-500">{{ charity.name }}</p>
</div>

{% include 'components/flash.html.twig' %}

<!-- Sub-navigation -->
<div class="border-b border-gray-200 mb-6">
    <nav class="flex space-x-8">
        <a href="/charity/{{ charity.id }}/members" 
           class="border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300">
            All Members
        </a>
        <a href="/charity/{{ charity.id }}/members/trustees" 
           class="border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300">
            Trustees
        </a>
        <a href="/charity/{{ charity.id }}/members/dues" 
           class="border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300">
            Membership Dues
        </a>
        <a href="/charity/{{ charity.id }}/members/types" 
           class="border-b-2 border-blue-500 py-2 px-1 text-sm font-medium text-blue-600">
            Membership Types
        </a>
    </nav>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Existing Types -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Current Types</h2>
        </div>
        <div class="divide-y divide-gray-200">
            {% for type in types %}
                <form method="post" action="/charity/{{ charity.id }}/members/types/{{ type.id }}" class="px-6 py-4">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Name</label>
                            <input type="text" name="name" value="{{ type.name }}" required maxlength="50"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Description</label>
                            <input type="text" name="description" value="{{ type.description }}" maxlength="255"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Annual Fee (£)</label>
                            <input type="number" name="annual_fee" value="{{ type.annual_fee }}" step="0.01" min="0"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                        <div>
                            <button type="submit" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 text-sm">
                                Update
                            </button>
                        </div>
                    </div>
                </form>
            {% else %}
                <div class="px-6 py-8 text-center text-gray-500">
                    No membership types defined.
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Add New Type -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Add New Type</h2>
        </div>
        <form method="post" action="/charity/{{ charity.id }}/members/types" class="px-6 py-4">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="space-y-4">
                <div>
                    <label for="new_name" class="block text-sm font-medium text-gray-700">Name *</label>
                    <input type="text" name="name" id="new_name" required maxlength="50"
                           placeholder="e.g. Family, Concession, Life"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
                <div>
                    <label for="new_description" class="block text-sm font-medium text-gray-700">Description</label>
                    <input type="text" name="description" id="new_description" maxlength="255"
                           placeholder="Brief description of this membership type"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
                <div>
                    <label for="new_annual_fee" class="block text-sm font-medium text-gray-700">Annual Fee (£)</label>
                    <input type="number" name="annual_fee" id="new_annual_fee" step="0.01" min="0"
                           placeholder="0.00"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>
                <div>
                    <button type="submit" class="w-full px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                        Add Type
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="mt-6 bg-gray-50 rounded-lg p-4 border border-gray-200">
    <h3 class="text-sm font-medium text-gray-900 mb-2">About Membership Types</h3>
    <ul class="text-sm text-gray-500 space-y-1">
        <li>• Membership types help categorize members (e.g., Standard, Family, Concession)</li>
        <li>• Set an annual fee to auto-populate when generating dues</li>
        <li>• Leave annual fee blank for honorary or free memberships</li>
        <li>• Types cannot be deleted if members are using them</li>
    </ul>
</div>
{% endblock %}
