{% extends "layouts/charity.html.twig" %}

{% block title %}Trustees - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Trustees</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>
    <button type="button" onclick="document.getElementById('export-modal').classList.remove('hidden')" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Export
    </button>
</div>

{% include 'components/flash.html.twig' %}

<!-- Sub-navigation -->
<div class="border-b border-gray-200 mb-6">
    <nav class="flex space-x-8">
        <a href="/charity/{{ charity.id }}/members" 
           class="border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300">
            All Members
        </a>
        <a href="/charity/{{ charity.id }}/members/trustees" 
           class="border-b-2 border-blue-500 py-2 px-1 text-sm font-medium text-blue-600">
            Trustees
        </a>
        <a href="/charity/{{ charity.id }}/members/dues" 
           class="border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300">
            Membership Dues
        </a>
        {% if permissions.members_edit %}
        <a href="/charity/{{ charity.id }}/members/types" 
           class="border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300">
            Membership Types
        </a>
        {% endif %}
    </nav>
</div>

<!-- Current Trustees Grid -->
<h2 class="text-lg font-medium text-gray-900 mb-4">Current Trustees</h2>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    {% for trustee in trustees %}
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-start justify-between">
                <div>
                    <h3 class="text-lg font-medium text-gray-900">
                        {{ trustee.name }}
                    </h3>
                    {% if trustee.trustee_role %}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 mt-1">
                            {{ trustee.trustee_role }}
                        </span>
                    {% endif %}
                </div>
                <a href="/charity/{{ charity.id }}/members/{{ trustee.id }}" class="text-blue-600 hover:text-blue-800 text-sm">View</a>
            </div>
            
            <div class="mt-4 space-y-2 text-sm text-gray-600">
                {% if trustee.email %}
                    <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <a href="mailto:{{ trustee.email }}" class="text-blue-600 hover:text-blue-800">{{ trustee.email }}</a>
                    </div>
                {% endif %}
                {% if trustee.phone %}
                    <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        {{ trustee.phone }}
                    </div>
                {% endif %}
                {% if trustee.trustee_start_date %}
                    <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        Since {{ trustee.trustee_start_date|date("M Y") }}
                    </div>
                {% endif %}
            </div>

            {% if permissions.members_manage_trustees %}
            <div class="mt-4 pt-4 border-t border-gray-100">
                <form id="end-trustee-form-{{ trustee.id }}" method="post" action="/charity/{{ charity.id }}/members/{{ trustee.id }}/trustee-role/end" class="inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="button" class="text-sm text-red-600 hover:text-red-800" onclick="showConfirmModal('End Trustee Role', 'End trustee role for {{ trustee.name|e('js') }}?', function() { document.getElementById('end-trustee-form-{{ trustee.id }}').submit(); })">
                        End Trustee Role
                    </button>
                </form>
            </div>
            {% endif %}
        </div>
    {% else %}
        <div class="col-span-full bg-white rounded-lg shadow p-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No current trustees</h3>
            <p class="mt-1 text-sm text-gray-500">
                Add trustee roles from individual member profiles.
            </p>
        </div>
    {% endfor %}
</div>

<!-- Past Trustees Table -->
{% if past_trustees is defined and past_trustees|length > 0 %}
<h2 class="text-lg font-medium text-gray-900 mb-4">Past Trustees</h2>
<div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Period</th>
                <th class="px-6 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            {% for trustee in past_trustees %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900">
                            {{ trustee.name }}
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        {{ trustee.role ?: 'Trustee' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        {{ trustee.start_date|date("M Y") }} – {{ trustee.end_date|date("M Y") }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                        <a href="/charity/{{ charity.id }}/members/{{ trustee.member_id }}" class="text-blue-600 hover:text-blue-800">View Member</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<!-- Export Modal -->
<div id="export-modal" class="hidden fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-lg w-full mx-4">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <div class="flex items-center">
                <div class="flex items-center justify-center h-10 w-10 rounded-full bg-blue-100 mr-3">
                    <svg class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900" id="export-modal-title">Export Trustees</h3>
            </div>
            <button type="button" onclick="document.getElementById('export-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-500">
                <span class="sr-only">Close</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <form id="export-form" method="get" action="/charity/{{ charity.id }}/members/trustees/export">
            <div class="px-6 py-4">
                <p class="text-sm text-gray-500 mb-4">Choose your export options. The file will download as a CSV.</p>
                <div class="space-y-4">
                    {% if permissions.members_view_detail %}
                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <input id="include_addresses" name="include_addresses" value="1" type="checkbox"
                                   class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                        </div>
                        <div class="ml-3 text-sm">
                            <label for="include_addresses" class="font-medium text-gray-700">Include addresses</label>
                            <p class="text-gray-500">Add address columns to the export</p>
                        </div>
                    </div>
                    {% endif %}

                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <input id="include_past" name="include_past" value="1" type="checkbox"
                                   class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                        </div>
                        <div class="ml-3 text-sm">
                            <label for="include_past" class="font-medium text-gray-700">Include past trustees</label>
                            <p class="text-gray-500">Export all trustee history including former trustees</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
                <button type="button" onclick="document.getElementById('export-modal').classList.add('hidden')" 
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                    Download CSV
                </button>
            </div>
        </form>
    </div>
</div>
<script>
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.getElementById('export-modal').classList.add('hidden');
    }
});
</script>
{% include 'components/confirm_modal.html.twig' %}
{% endblock %}
