{% extends "layouts/charity.html.twig" %}

{% block title %}{{ member.name }} - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
        <a href="/charity/{{ charity.id }}/members" class="hover:text-gray-700">Members</a>
        <span>›</span>
        <span>{{ member.name }}</span>
    </div>
    <div class="flex justify-between items-start">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">
                {{ member.name }}
            </h1>
            {% if member.member_number %}
                <p class="text-sm text-gray-500">Member #{{ member.member_number }}</p>
            {% endif %}
        </div>
        {% if permissions.members_edit %}
        <div class="space-x-2">
            <a href="/charity/{{ charity.id }}/members/{{ member.id }}/edit" 
               class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50">
                Edit
            </a>
            <a href="/charity/{{ charity.id }}/members" 
               class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50">
                Back to List
            </a>
        </div>
        {% else %}
        <a href="/charity/{{ charity.id }}/members" 
           class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50">
            Back to List
        </a>
        {% endif %}
    </div>
</div>

{% include 'components/flash.html.twig' %}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Member Details -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Basic Info Card -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Member Information</h2>
            </div>
            <div class="px-6 py-4">
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Membership Type</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ member.membership_type }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Joined Date</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ member.joined_date ? member.joined_date|date("d M Y") : '—' }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Status</dt>
                        <dd class="mt-1">
                            {% if member.is_active %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
                                {% if member.left_date %}
                                    <span class="text-sm text-gray-500 ml-2">Left: {{ member.left_date|date("d M Y") }}</span>
                                {% endif %}
                            {% endif %}
                        </dd>
                    </div>
                    {% if member.is_trustee %}
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Current Trustee Role</dt>
                        <dd class="mt-1">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                {{ member.trustee_role ?: 'Trustee' }}
                            </span>
                            {% if member.trustee_start_date %}
                                <span class="text-sm text-gray-500 ml-2">Since {{ member.trustee_start_date|date("M Y") }}</span>
                            {% endif %}
                        </dd>
                    </div>
                    {% endif %}
                </dl>
            </div>
        </div>

        <!-- Contact Info Card -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Contact Information</h2>
            </div>
            <div class="px-6 py-4">
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Email</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {% if member.email %}
                                <a href="mailto:{{ member.email }}" class="text-blue-600 hover:text-blue-800">{{ member.email }}</a>
                            {% else %}
                                —
                            {% endif %}
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Phone</dt>
                        <dd class="mt-1 text-sm text-gray-900">{{ member.phone ?: '—' }}</dd>
                    </div>
                    <div class="md:col-span-2">
                        <dt class="text-sm font-medium text-gray-500">Address</dt>
                        <dd class="mt-1 text-sm text-gray-900">
                            {% if member.address_line1 %}
                                {{ member.address_line1 }}<br>
                                {% if member.address_line2 %}{{ member.address_line2 }}<br>{% endif %}
                                {% if member.address_city %}{{ member.address_city }}{% endif %}
                                {% if member.address_county %}, {{ member.address_county }}{% endif %}
                                {% if member.address_postcode %}<br>{{ member.address_postcode }}{% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Membership Dues -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900">Membership Dues</h2>
                {% if permissions.members_manage_dues %}
                <a href="/charity/{{ charity.id }}/members/{{ member.id }}/dues/create" 
                   class="text-sm text-blue-600 hover:text-blue-800">+ Add Dues</a>
                {% endif %}
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Period</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Paid</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for due in dues %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    {{ due.period_label ?: (due.period_start|date("Y")) }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    £{{ due.amount_due|number_format(2) }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    £{{ due.amount_paid|number_format(2) }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if due.status == 'paid' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                                    {% elseif due.status == 'partial' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Partial</span>
                                    {% elseif due.status == 'waived' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Waived</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Pending</span>
                                    {% endif %}
                                    {% if due.is_giftaid_eligible %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 ml-1" title="Gift Aid eligible">GA</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                                    {% if permissions.members_manage_dues and due.status in ['pending', 'partial'] %}
                                        <form method="post" action="/charity/{{ charity.id }}/members/dues/{{ due.id }}/payment" class="inline">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="amount" value="{{ due.amount_due - due.amount_paid }}">
                                            <input type="hidden" name="return_to" value="/charity/{{ charity.id }}/members/{{ member.id }}">
                                            <button type="submit" class="text-green-600 hover:text-green-800">Mark Paid</button>
                                        </form>
                                    {% elseif permissions.members_manage_dues and due.status in ['paid', 'waived'] %}
                                        <form id="undo-dues-form-{{ due.id }}" method="post" action="/charity/{{ charity.id }}/members/dues/{{ due.id }}/undo" class="inline">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="return_to" value="/charity/{{ charity.id }}/members/{{ member.id }}">
                                            <button type="button" class="text-orange-600 hover:text-orange-800" onclick="confirmAndSubmit('undo-dues-form-{{ due.id }}', 'Reset Dues', 'Reset this dues record to pending?')">Undo</button>
                                        </form>
                                    {% endif %}
                                    {% if permissions.members_manage_dues and due.amount_paid == 0 and not due.transaction_id %}
                                        <form id="delete-dues-form-{{ due.id }}" method="post" action="/charity/{{ charity.id }}/members/dues/{{ due.id }}/delete" class="inline">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="return_to" value="/charity/{{ charity.id }}/members/{{ member.id }}">
                                            <button type="button" class="text-red-600 hover:text-red-800 ml-3" onclick="confirmAndSubmit('delete-dues-form-{{ due.id }}', 'Delete Dues', 'Permanently delete this dues record? This cannot be undone.')">Delete</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                    No dues records yet.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Notes -->
        {% if member.notes %}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Notes</h2>
            </div>
            <div class="px-6 py-4">
                <p class="text-sm text-gray-700 whitespace-pre-wrap">{{ member.notes }}</p>
            </div>
        </div>
        {% endif %}

        <!-- Trustee History -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900">Trustee History</h2>
                {% if permissions.members_manage_trustees %}
                <button type="button" onclick="document.getElementById('add-trustee-role-modal').classList.remove('hidden')" 
                        class="text-sm text-blue-600 hover:text-blue-800">+ Add Trustee Role</button>
                {% endif %}
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Start Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">End Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for role in trustee_history %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    {{ role.role ?: 'Trustee' }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    {{ role.start_date|date("d M Y") }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    {{ role.end_date ? role.end_date|date("d M Y") : '—' }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if role.end_date is null %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Current</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Ended</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm space-x-2">
                                    {% if permissions.members_manage_trustees %}
                                        <button type="button" onclick="openEditTrusteeModal({{ role.id }}, '{{ role.role|e('js') }}', '{{ role.start_date }}', '{{ role.end_date }}', '{{ role.notes|e('js') }}')" 
                                                class="text-blue-600 hover:text-blue-800">Edit</button>
                                        {% if role.end_date is null %}
                                        <form id="end-role-form-{{ role.id }}" method="post" action="/charity/{{ charity.id }}/members/trustee-role/{{ role.id }}/end" class="inline">
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                            <button type="button" class="text-red-600 hover:text-red-800" onclick="showConfirmModal('End Trustee Role', 'End this trustee role?', function() { document.getElementById('end-role-form-{{ role.id }}').submit(); })">End Role</button>
                                        </form>
                                        {% endif %}
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                                    No trustee history recorded.
                                    {% if permissions.members_manage_trustees %}
                                    <button type="button" onclick="document.getElementById('add-trustee-role-modal').classList.remove('hidden')" 
                                            class="text-blue-600 hover:text-blue-800 ml-1">Add a trustee role</button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
        <!-- Donor Link Card -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Donor Record</h2>
            </div>
            <div class="px-6 py-4">
                {% if member.donor_id %}
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-900">{{ member.donor_name }}</p>
                            <p class="text-sm text-gray-500">
                                {% if member.has_giftaid_declaration %}
                                    <span class="text-green-600">✓ Gift Aid declaration active</span>
                                {% else %}
                                    <span class="text-gray-400">No Gift Aid declaration</span>
                                {% endif %}
                            </p>
                        </div>
                        <a href="/charity/{{ charity.id }}/donors/{{ member.donor_id }}" class="text-blue-600 hover:text-blue-800 text-sm">View</a>
                    </div>
                    {% if permissions.members_edit %}
                    <form method="post" action="/charity/{{ charity.id }}/members/{{ member.id }}/unlink-donor" class="mt-3">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="text-sm text-red-600 hover:text-red-800">Unlink from donor</button>
                    </form>
                    {% endif %}
                {% else %}
                    <p class="text-sm text-gray-500 mb-3">Not linked to a donor record. Link to enable Gift Aid on membership fees.</p>
                    {% if permissions.members_edit %}
                    <form method="post" action="/charity/{{ charity.id }}/members/{{ member.id }}/link-donor">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <div class="flex space-x-2">
                            <select name="donor_id" required class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
                                <option value="">Select donor...</option>
                                {% for donor in donors %}
                                    <option value="{{ donor.id }}">{{ donor.name }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="px-3 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700">Link</button>
                        </div>
                    </form>
                    {% if permissions.donors_create %}
                    <div class="mt-3 pt-3 border-t border-gray-200">
                        <p class="text-xs text-gray-500 mb-2">Or create a new donor record from this member's details:</p>
                        <form method="post" action="/charity/{{ charity.id }}/members/{{ member.id }}/create-donor">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="w-full px-3 py-2 bg-green-600 text-white rounded-md text-sm hover:bg-green-700">
                                Create Donor Record
                            </button>
                        </form>
                    </div>
                    {% endif %}
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <!-- Quick Actions -->
        {% if permissions.members_manage_dues or permissions.members_manage_trustees %}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Actions</h2>
            </div>
            <div class="px-6 py-4 space-y-2">
                {% if permissions.members_manage_dues %}
                <a href="/charity/{{ charity.id }}/members/{{ member.id }}/dues/create" 
                   class="block w-full text-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Add Dues Record
                </a>
                {% endif %}
                {% if member.email %}
                <a href="mailto:{{ member.email }}" 
                   class="block w-full text-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Send Email
                </a>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Privacy / GDPR Actions -->
        {% if can_export_privacy or can_delete_privacy %}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Privacy</h2>
            </div>
            <div class="px-6 py-4 space-y-2">
                {% if can_export_privacy %}
                <a href="/charity/{{ charity.id }}/members/{{ member.id }}/privacy/export"
                   class="block w-full text-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Export Data (SAR)
                </a>
                {% endif %}
                {% if can_delete_privacy %}
                <a href="/charity/{{ charity.id }}/members/{{ member.id }}/privacy/delete"
                   class="block w-full text-center px-4 py-2 border border-red-300 rounded-md text-sm font-medium text-red-700 bg-white hover:bg-red-50">
                    Request Deletion (GDPR)
                </a>
                {% endif %}
            </div>
        </div>
        {% endif %}

        <!-- Delete Member (only if no trustee history) -->
        {% if permissions.members_edit and trustee_history is empty %}
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Danger Zone</h2>
            </div>
            <div class="px-6 py-4">
                <p class="text-sm text-gray-500 mb-3">Permanently delete this member and their dues records.</p>
                <form id="delete-member-form" method="post" action="/charity/{{ charity.id }}/members/{{ member.id }}/delete">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="button" onclick="confirmAndSubmit('delete-member-form', 'Delete Member', 'Are you sure you want to permanently delete this member? This cannot be undone.')"
                            class="w-full px-4 py-2 border border-red-300 rounded-md shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50">
                        Delete Member
                    </button>
                </form>
            </div>
        </div>
        {% endif %}
    </div>
</div>

<!-- Add Trustee Role Modal -->
{% if permissions.members_manage_trustees %}
<div id="add-trustee-role-modal" class="hidden fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <form method="post" action="/charity/{{ charity.id }}/members/{{ member.id }}/trustee-role">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Add Trustee Role</h3>
            </div>
            <div class="px-6 py-4 space-y-4">
                <div>
                    <label for="role" class="block text-sm font-medium text-gray-700">Role</label>
                    <input type="text" name="role" id="role" maxlength="100"
                           placeholder="e.g. Chair, Treasurer, Secretary, Trustee"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                </div>
                <div>
                    <label for="start_date" class="block text-sm font-medium text-gray-700">Start Date</label>
                    <input type="date" name="start_date" id="start_date" required 
                           value="{{ "now"|date("Y-m-d") }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
                <button type="button" onclick="document.getElementById('add-trustee-role-modal').classList.add('hidden')" 
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                    Add Role
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Trustee Role Modal -->
<div id="edit-trustee-role-modal" class="hidden fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <form id="edit-trustee-form" method="post" action="">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-medium text-gray-900">Edit Trustee Role</h3>
            </div>
            <div class="px-6 py-4 space-y-4">
                <div>
                    <label for="edit_role" class="block text-sm font-medium text-gray-700">Role</label>
                    <input type="text" name="role" id="edit_role" maxlength="100"
                           placeholder="e.g. Chair, Treasurer, Secretary, Trustee"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                </div>
                <div>
                    <label for="edit_start_date" class="block text-sm font-medium text-gray-700">Start Date</label>
                    <input type="date" name="start_date" id="edit_start_date" required 
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                </div>
                <div>
                    <label for="edit_end_date" class="block text-sm font-medium text-gray-700">End Date</label>
                    <input type="date" name="end_date" id="edit_end_date"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                    <p class="mt-1 text-xs text-gray-500">Leave blank if role is still current</p>
                </div>
                <div>
                    <label for="edit_notes" class="block text-sm font-medium text-gray-700">Notes</label>
                    <textarea name="notes" id="edit_notes" rows="2"
                              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"></textarea>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-3">
                <button type="button" onclick="document.getElementById('edit-trustee-role-modal').classList.add('hidden')" 
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditTrusteeModal(roleId, role, startDate, endDate, notes) {
    document.getElementById('edit-trustee-form').action = '/charity/{{ charity.id }}/members/trustee-role/' + roleId + '/update';
    document.getElementById('edit_role').value = role || '';
    document.getElementById('edit_start_date').value = startDate || '';
    document.getElementById('edit_end_date').value = endDate || '';
    document.getElementById('edit_notes').value = notes || '';
    document.getElementById('edit-trustee-role-modal').classList.remove('hidden');
}
</script>
{% endif %}
