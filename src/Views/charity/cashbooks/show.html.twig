{% extends "layouts/charity.html.twig" %}

{% block title %}{{ cash_book.name }} - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">{{ cash_book.name }}</h1>
        <p class="text-sm text-gray-500">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
                {% if cash_book.book_type == 'bank' %}bg-blue-100 text-blue-800
                {% elseif cash_book.book_type == 'cash' %}bg-green-100 text-green-800
                {% elseif cash_book.book_type == 'online' %}bg-purple-100 text-purple-800
                {% else %}bg-gray-100 text-gray-800{% endif %}">
                {{ cash_book.book_type|capitalize }}
            </span>
            {% if cash_book.account_number %}
                · {{ cash_book.sort_code }} {{ cash_book.account_number }}
            {% endif %}
        </p>
    </div>
    <div class="space-x-2">
        <a href="/charity/{{ charity.id }}/cashbooks/{{ cash_book.id }}/reconcile" 
           class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
            Reconcile
        </a>
        {% if permissions.cashbooks_manage %}
        <a href="/charity/{{ charity.id }}/cashbooks/{{ cash_book.id }}/edit" 
           class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            Edit
        </a>
        {% endif %}
        <a href="/charity/{{ charity.id }}/cashbooks" 
           class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            Back to List
        </a>
    </div>
</div>

{% include 'components/flash.html.twig' %}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Balance Summary -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Balance</h2>
            </div>
            <div class="px-6 py-4">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <p class="text-xs text-gray-500">Opening Balance</p>
                        <p class="text-lg font-medium text-gray-900">£{{ balance.opening_balance|number_format(2) }}</p>
                        <p class="text-xs text-gray-400">{{ balance.opening_date|date('d M Y') }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500">Total Income</p>
                        <p class="text-lg font-medium text-green-600">+£{{ balance.total_income|number_format(2) }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500">Total Expenses</p>
                        <p class="text-lg font-medium text-red-600">-£{{ balance.total_expenses|number_format(2) }}</p>
                    </div>
                    <div>
                        <p class="text-xs text-gray-500">Current Balance</p>
                        <p class="text-2xl font-bold {{ balance.current_balance >= 0 ? 'text-green-600' : 'text-red-600' }}">
                            £{{ balance.current_balance|number_format(2) }}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900">Transactions</h2>
                {% if unreconciled_count > 0 %}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        {{ unreconciled_count }} unreconciled
                    </span>
                {% endif %}
            </div>
            <div class="divide-y divide-gray-200">
                {% if transactions is empty %}
                    <div class="px-6 py-8 text-center text-gray-500">
                        No transactions linked to this cash book yet.
                    </div>
                {% else %}
                    {% for t in transactions %}
                        <div class="px-6 py-4 {{ not t.is_reconciled ? 'bg-yellow-50' : '' }}">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-sm font-medium text-gray-900">{{ t.description }}</p>
                                    <p class="text-xs text-gray-500">
                                        {{ t.transaction_date|date('d M Y') }}
                                        · {{ t.fund_name }}
                                        {% if t.reporting_category_name %} · {{ t.reporting_category_name }}{% endif %}
                                    </p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-medium {{ t.transaction_type == 'receipt' ? 'text-green-600' : 'text-red-600' }}">
                                        {{ t.transaction_type == 'receipt' ? '+' : '-' }}£{{ t.amount|number_format(2) }}
                                    </p>
                                    {% if t.is_reconciled %}
                                        <span class="text-xs text-green-600">✓ Reconciled</span>
                                    {% else %}
                                        <span class="text-xs text-yellow-600">Pending</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
        <!-- Details -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Details</h2>
            </div>
            <div class="px-6 py-4 space-y-3">
                {% if cash_book.description %}
                    <div>
                        <p class="text-xs text-gray-500">Description</p>
                        <p class="text-sm text-gray-900">{{ cash_book.description }}</p>
                    </div>
                {% endif %}
                {% if cash_book.sort_code %}
                    <div>
                        <p class="text-xs text-gray-500">Sort Code</p>
                        <p class="text-sm text-gray-900">{{ cash_book.sort_code }}</p>
                    </div>
                {% endif %}
                {% if cash_book.account_number %}
                    <div>
                        <p class="text-xs text-gray-500">Account Number</p>
                        <p class="text-sm text-gray-900">{{ cash_book.account_number }}</p>
                    </div>
                {% endif %}
                <div>
                    <p class="text-xs text-gray-500">Status</p>
                    <p class="text-sm">
                        {% if cash_book.is_active %}
                            <span class="text-green-600">Active</span>
                        {% else %}
                            <span class="text-gray-500">Inactive</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        <!-- Reconciliation History -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Reconciliation History</h2>
            </div>
            <div class="divide-y divide-gray-200">
                {% if reconciliations is empty %}
                    <div class="px-6 py-4 text-sm text-gray-500">
                        Not yet reconciled.
                    </div>
                {% else %}
                    {% for r in reconciliations[:5] %}
                        <div class="px-6 py-3">
                            <div class="flex justify-between">
                                <p class="text-sm font-medium text-gray-900">{{ r.reconciled_date|date('d M Y') }}</p>
                                <p class="text-sm text-gray-900">£{{ r.statement_balance|number_format(2) }}</p>
                            </div>
                            {% if r.discrepancy != 0 %}
                                <p class="text-xs text-red-600">
                                    Discrepancy: £{{ r.discrepancy|number_format(2) }}
                                </p>
                            {% endif %}
                            {% if r.notes %}
                                <p class="text-xs text-gray-500">{{ r.notes|slice(0, 50) }}{% if r.notes|length > 50 %}...{% endif %}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
