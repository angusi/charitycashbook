{% extends "layouts/charity.html.twig" %}

{% block title %}Cash Books - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Cash Books</h1>
        <p class="text-sm text-gray-500">Bank accounts, petty cash, and other money holdings</p>
    </div>
    {% if permissions.cashbooks_manage %}
    <a href="/charity/{{ charity.id }}/cashbooks/create" 
       class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
        <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Add Cash Book
    </a>
    {% endif %}
</div>

{% include 'components/flash.html.twig' %}

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm font-medium text-gray-500">Total Balance</p>
        <p class="text-2xl font-semibold {{ summary.total_balance >= 0 ? 'text-green-600' : 'text-red-600' }}">
            £{{ summary.total_balance|number_format(2) }}
        </p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm font-medium text-gray-500">Cash Books</p>
        <p class="text-2xl font-semibold text-gray-900">{{ summary.cash_books|length }}</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm font-medium text-gray-500">Unlinked Transactions</p>
        <p class="text-2xl font-semibold {{ summary.unlinked_count > 0 ? 'text-yellow-600' : 'text-gray-900' }}">
            {{ summary.unlinked_count }}
        </p>
        {% if summary.unlinked_count > 0 %}
            <a href="/charity/{{ charity.id }}/cashbooks/unlinked" class="text-xs text-blue-600 hover:text-blue-800">Review →</a>
        {% endif %}
    </div>
</div>

<!-- Cash Books List -->
{% if summary.cash_books is empty %}
    <div class="bg-white rounded-lg shadow p-8 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
        <h3 class="mt-2 text-lg font-medium text-gray-900">No cash books</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by adding your first cash book.</p>
        {% if permissions.cashbooks_manage %}
        <div class="mt-4">
            <a href="/charity/{{ charity.id }}/cashbooks/create" 
               class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                Add Cash Book
            </a>
        </div>
        {% endif %}
    </div>
{% else %}
    <div class="bg-white rounded-lg shadow overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Balance</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Reconciled</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Unreconciled</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for item in summary.cash_books %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <a href="/charity/{{ charity.id }}/cashbooks/{{ item.cash_book.id }}" class="text-sm font-medium text-blue-600 hover:text-blue-800">
                                {{ item.cash_book.name }}
                            </a>
                            {% if item.cash_book.description %}
                                <p class="text-xs text-gray-500">{{ item.cash_book.description|slice(0, 50) }}{% if item.cash_book.description|length > 50 %}...{% endif %}</p>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                {% if item.cash_book.book_type == 'bank' %}bg-blue-100 text-blue-800
                                {% elseif item.cash_book.book_type == 'cash' %}bg-green-100 text-green-800
                                {% elseif item.cash_book.book_type == 'online' %}bg-purple-100 text-purple-800
                                {% else %}bg-gray-100 text-gray-800{% endif %}">
                                {{ item.cash_book.book_type|capitalize }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right">
                            <span class="text-sm font-medium {{ item.balance >= 0 ? 'text-green-600' : 'text-red-600' }}">
                                £{{ item.balance|number_format(2) }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {% if item.last_reconciled %}
                                {{ item.last_reconciled|date('d M Y') }}
                            {% else %}
                                <span class="text-yellow-600">Never</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-center">
                            {% if item.unreconciled_count > 0 %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    {{ item.unreconciled_count }}
                                </span>
                            {% else %}
                                <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="/charity/{{ charity.id }}/cashbooks/{{ item.cash_book.id }}/reconcile" class="text-green-600 hover:text-green-800 mr-3">Reconcile</a>
                            <a href="/charity/{{ charity.id }}/cashbooks/{{ item.cash_book.id }}" class="text-blue-600 hover:text-blue-800">View</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}
