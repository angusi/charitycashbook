{% extends "layouts/charity.html.twig" %}

{% block title %}Edit Operational Category - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Edit Operational Category</h1>
    <p class="text-sm text-gray-500">{{ charity.name }}</p>
</div>

{% include 'components/flash.html.twig' %}

<div class="bg-white rounded-lg shadow">
    <form method="post" action="/charity/{{ charity.id }}/categories/operational/{{ category.id }}" class="p-6 space-y-6">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div>
            <label for="name" class="block text-sm font-medium text-gray-700">Category Name</label>
            <input type="text" name="name" id="name" value="{{ category.name }}" required maxlength="100"
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
        </div>

        <div>
            <label for="reporting_category_id" class="block text-sm font-medium text-gray-700">Reporting Category</label>
            <select name="reporting_category_id" id="reporting_category_id" required
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                {% for rc in reporting_categories %}
                    <option value="{{ rc.id }}" {{ rc.id == category.reporting_category_id ? 'selected' : '' }}>
                        {{ rc.name }}
                    </option>
                {% endfor %}
            </select>
            <p class="mt-1 text-sm text-gray-500">
                This is a {{ category.category_type }} category
            </p>
        </div>

        <div>
            <label for="display_order" class="block text-sm font-medium text-gray-700">Display Order</label>
            <input type="number" name="display_order" id="display_order" value="{{ category.display_order }}" min="0"
                   class="mt-1 block w-32 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            <p class="mt-1 text-sm text-gray-500">Lower numbers appear first within the reporting category</p>
        </div>

        <div class="flex items-start">
            <div class="flex items-center h-5">
                <input type="checkbox" name="giftaid_eligible_default" id="giftaid_eligible_default" 
                       {{ category.giftaid_eligible_default ? 'checked' : '' }}
                       class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            </div>
            <div class="ml-3 text-sm">
                <label for="giftaid_eligible_default" class="font-medium text-gray-700">Gift Aid Eligible by Default</label>
                <p class="text-gray-500">New receipts in this category will default to Gift Aid eligible</p>
            </div>
        </div>

        <div class="flex justify-between pt-4 border-t border-gray-200">
            <a href="/charity/{{ charity.id }}/categories" class="text-sm text-gray-600 hover:text-gray-900">Cancel</a>
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Save Changes
            </button>
        </div>
    </form>
</div>
{% endblock %}
