{% extends "layouts/charity.html.twig" %}

{% block title %}Funds - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Funds</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>
    {% if permissions.funds_manage %}
        <a href="/charity/{{ charity.id }}/funds/create" 
           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
            + New Fund
        </a>
    {% endif %}
</div>

{% include 'components/flash.html.twig' %}

<!-- Summary -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm text-gray-500">Total Receipts</p>
        <p class="text-xl font-semibold text-green-600">£{{ total_receipts|number_format(2) }}</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm text-gray-500">Total Payments</p>
        <p class="text-xl font-semibold text-red-600">£{{ total_payments|number_format(2) }}</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm text-gray-500">Total Balance</p>
        <p class="text-xl font-semibold {{ total_balance >= 0 ? 'text-green-600' : 'text-red-600' }}">£{{ total_balance|number_format(2) }}</p>
    </div>
</div>

<!-- Filters -->
<div class="mb-4">
    <form method="get" class="flex items-center space-x-4">
        <label class="flex items-center">
            <input type="checkbox" name="show_inactive" value="1" {{ show_inactive ? 'checked' : '' }}
                   onchange="this.form.submit()"
                   class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-500 focus:ring-blue-500">
            <span class="ml-2 text-sm text-gray-700">Show inactive funds</span>
        </label>
    </form>
</div>

<!-- Funds Table -->
<div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fund Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Opening</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Receipts</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Payments</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
                <th class="px-6 py-3"></th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% if funds is empty %}
                <tr>
                    <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                        No funds configured. Create a fund to start recording transactions.
                    </td>
                </tr>
            {% else %}
                {% for fund in funds %}
                    <tr class="hover:bg-gray-50 {{ not fund.is_active ? 'bg-gray-100 text-gray-500' : '' }}">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900">{{ fund.name }}</div>
                            {% if not fund.is_active %}
                                <span class="text-xs text-gray-500">(Inactive)</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 capitalize">
                            {{ fund.fund_type }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900">
                            £{{ fund.opening|number_format(2) }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-green-600">
                            £{{ fund.receipts|number_format(2) }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-red-600">
                            £{{ fund.payments|number_format(2) }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-medium {{ fund.balance >= 0 ? 'text-green-600' : 'text-red-600' }}">
                            £{{ fund.balance|number_format(2) }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            {% if permissions.funds_manage %}
                                <a href="/charity/{{ charity.id }}/funds/{{ fund.id }}/edit" class="text-blue-600 hover:text-blue-900">Edit</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
        {% if funds is not empty %}
            <tfoot class="bg-gray-50">
                <tr>
                    <td colspan="3" class="px-6 py-3 text-sm font-medium text-gray-900">Totals</td>
                    <td class="px-6 py-3 text-sm text-right font-medium text-green-600">£{{ total_receipts|number_format(2) }}</td>
                    <td class="px-6 py-3 text-sm text-right font-medium text-red-600">£{{ total_payments|number_format(2) }}</td>
                    <td class="px-6 py-3 text-sm text-right font-bold {{ total_balance >= 0 ? 'text-green-600' : 'text-red-600' }}">£{{ total_balance|number_format(2) }}</td>
                    <td></td>
                </tr>
            </tfoot>
        {% endif %}
    </table>
</div>
{% endblock %}
