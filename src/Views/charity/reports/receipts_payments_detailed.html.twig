{% extends "layouts/charity.html.twig" %}

{% block title %}Detailed R&P - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Detailed Receipts & Payments</h1>
        <p class="text-sm text-gray-500">{{ charity.name }} - Additional Notes Breakdown</p>
    </div>
    <a href="/charity/{{ charity.id }}/reports" class="text-sm text-blue-600 hover:text-blue-800">← Back to Reports</a>
</div>

{% include 'components/report_date_picker.html.twig' %}

<!-- Report -->
{% set cols = report.fund_types %}
<div class="bg-white rounded-lg shadow overflow-x-auto" id="report-content">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-medium text-gray-900">{{ charity.name }}</h2>
        <p class="text-sm text-gray-600">Detailed Receipts and Payments Account</p>
        <p class="text-sm text-gray-600">For the period {{ date_from }} to {{ date_to }}</p>
    </div>

    <div class="p-6">
        {% for section in [
            {key: 'receipts', title: 'RECEIPTS', border: 'border-green-500', bg: 'bg-green-50', empty: 'No receipts in this period'},
            {key: 'payments', title: 'PAYMENTS', border: 'border-red-500', bg: 'bg-red-50', empty: 'No payments in this period'},
        ] %}
        <div class="mb-8">
            <h3 class="text-lg font-bold text-gray-900 border-b-2 {{ section.border }} pb-2 mb-4">{{ section.title }}</h3>
            <table class="w-full">
                <thead>
                    <tr class="text-sm text-gray-500">
                        <th class="text-left pb-2">Category</th>
                        {% for type in cols %}
                            <th class="text-right pb-2 w-28">{{ report.fund_type_labels[type] }}</th>
                        {% endfor %}
                        <th class="text-right pb-2 w-28">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rc in report[section.key] %}
                        <tr class="border-b border-gray-200 bg-gray-50">
                            <td class="py-2 text-sm font-semibold text-gray-900">{{ rc.name }}</td>
                            {% for type in cols %}
                                <td class="py-2 text-sm text-right font-semibold text-gray-900">£{{ rc.amounts[type]|default(0)|number_format(2) }}</td>
                            {% endfor %}
                            <td class="py-2 text-sm text-right font-semibold text-gray-900">£{{ rc.total|number_format(2) }}</td>
                        </tr>
                        {% for oc in rc.operational %}
                            <tr class="border-b border-gray-100">
                                <td class="py-1 pl-6 text-sm text-gray-700">{{ oc.name }}</td>
                                {% for type in cols %}
                                    <td class="py-1 text-sm text-right text-gray-700">£{{ oc.amounts[type]|default(0)|number_format(2) }}</td>
                                {% endfor %}
                                <td class="py-1 text-sm text-right text-gray-700">£{{ oc.total|number_format(2) }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="{{ cols|length + 2 }}" class="py-4 text-sm text-gray-500 text-center">{{ section.empty }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="{{ section.bg }}">
                        <td class="py-3 text-sm font-bold text-gray-900">Total {{ section.key|capitalize }}</td>
                        {% for type in cols %}
                            <td class="py-3 text-sm text-right font-bold text-gray-900">£{{ report.totals[section.key][type]|default(0)|number_format(2) }}</td>
                        {% endfor %}
                        <td class="py-3 text-sm text-right font-bold text-gray-900">£{{ report.totals[section.key]['total']|number_format(2) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        {% endfor %}

        {% include 'charity/reports/_rp_balances.html.twig' %}
    </div>
</div>

<div class="mt-4 flex justify-between items-center">
    <p class="text-sm text-gray-500">
        This detailed breakdown is suitable for OSCR Additional Notes.
    </p>
    <button onclick="window.print()" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900">
        Print Report
    </button>
</div>
{% endblock %}
