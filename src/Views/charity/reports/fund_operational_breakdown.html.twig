{% extends "layouts/charity.html.twig" %}

{% block title %}Fund Operational Breakdown - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Fund-by-Fund Operational Category Breakdown</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>
    <a href="/charity/{{ charity.id }}/reports" class="text-sm text-blue-600 hover:text-blue-800">&larr; Back to Reports</a>
</div>

{% include 'components/report_date_picker.html.twig' %}

{% set label_col_width = '260px' %}
{% set fund_col_width = '140px' %}
{% set total_col_width = '140px' %}

<!-- Report -->
<div class="bg-white rounded-lg shadow overflow-x-auto" id="report-content">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-lg font-medium text-gray-900">{{ charity.name }}</h2>
        <p class="text-sm text-gray-600">Fund-by-Fund Operational Category Analysis</p>
        <p class="text-sm text-gray-600">For the period {{ date_from }} to {{ date_to }}</p>
    </div>

    <div class="p-6 overflow-x-auto">
        {% if report.funds is empty %}
        <div class="text-center py-8 text-gray-500">
            <p>No funds have been set up yet.</p>
            <a href="/charity/{{ charity.id }}/funds/create" class="text-blue-600 hover:text-blue-800">Create a fund</a>
        </div>
        {% else %}
        <!-- Opening Balances -->
        <div class="mb-8">
            <h3 class="text-lg font-bold text-gray-900 border-b-2 border-gray-500 pb-2 mb-4">OPENING BALANCES</h3>
            <table class="w-full min-w-max">
                <colgroup>
                    <col style="width: {{ label_col_width }};">
                    {% for fund in report.funds %}
                    <col style="width: {{ fund_col_width }};">
                    {% endfor %}
                    <col style="width: {{ total_col_width }};">
                </colgroup>
                <thead>
                    <tr class="text-sm text-gray-500">
                        <th class="text-left pb-2 pr-4 min-w-[250px]"></th>
                        {% for fund in report.funds %}
                        <th class="text-right pb-2 px-2 min-w-[100px]">{{ fund.name }}</th>
                        {% endfor %}
                        <th class="text-right pb-2 pl-4 min-w-[100px] font-bold">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="bg-gray-50">
                        <td class="py-2 text-sm font-medium text-gray-900 pr-4">Balance at {{ date_from }}</td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right text-gray-900 px-2">&pound;{{ report.fund_totals[fund.id].opening|number_format(2) }}</td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-bold text-gray-900 pl-4">&pound;{{ report.grand_totals.opening|number_format(2) }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Receipts Section -->
        <div class="mb-8">
            <h3 class="text-lg font-bold text-gray-900 border-b-2 border-green-500 pb-2 mb-4">RECEIPTS</h3>
            <table class="w-full min-w-max">
                <colgroup>
                    <col style="width: {{ label_col_width }};">
                    {% for fund in report.funds %}
                    <col style="width: {{ fund_col_width }};">
                    {% endfor %}
                    <col style="width: {{ total_col_width }};">
                </colgroup>
                <thead>
                    <tr class="text-sm text-gray-500">
                        <th class="text-left pb-2 pr-4 min-w-[250px]">Operational Category</th>
                        {% for fund in report.funds %}
                        <th class="text-right pb-2 px-2 min-w-[100px]">{{ fund.name }}</th>
                        {% endfor %}
                        <th class="text-right pb-2 pl-4 min-w-[100px] font-bold">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in report.receipt_categories %}
                    <tr class="border-b border-gray-100">
                        <td class="py-2 text-sm text-gray-900 pr-4">
                            {{ category.name }}
                            {% if category.reporting_category_name %}
                            <span class="text-xs text-gray-500">({{ category.reporting_category_name }})</span>
                            {% endif %}
                        </td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right text-gray-900 px-2">
                            {% if category.funds[fund.id] > 0 %}
                            &pound;{{ category.funds[fund.id]|number_format(2) }}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-medium text-gray-900 pl-4">&pound;{{ category.total|number_format(2) }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="{{ report.funds|length + 2 }}" class="py-4 text-sm text-gray-500 text-center">No receipts in this period</td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="bg-green-50">
                        <td class="py-2 text-sm font-bold text-gray-900 pr-4">Total Receipts</td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right font-bold text-gray-900 px-2">&pound;{{ report.fund_totals[fund.id].receipts|number_format(2) }}</td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-bold text-green-700 pl-4">&pound;{{ report.grand_totals.receipts|number_format(2) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Payments Section -->
        <div class="mb-8">
            <h3 class="text-lg font-bold text-gray-900 border-b-2 border-red-500 pb-2 mb-4">PAYMENTS</h3>
            <table class="w-full min-w-max">
                <colgroup>
                    <col style="width: {{ label_col_width }};">
                    {% for fund in report.funds %}
                    <col style="width: {{ fund_col_width }};">
                    {% endfor %}
                    <col style="width: {{ total_col_width }};">
                </colgroup>
                <thead>
                    <tr class="text-sm text-gray-500">
                        <th class="text-left pb-2 pr-4 min-w-[250px]">Operational Category</th>
                        {% for fund in report.funds %}
                        <th class="text-right pb-2 px-2 min-w-[100px]">{{ fund.name }}</th>
                        {% endfor %}
                        <th class="text-right pb-2 pl-4 min-w-[100px] font-bold">Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in report.payment_categories %}
                    <tr class="border-b border-gray-100">
                        <td class="py-2 text-sm text-gray-900 pr-4">
                            {{ category.name }}
                            {% if category.reporting_category_name %}
                            <span class="text-xs text-gray-500">({{ category.reporting_category_name }})</span>
                            {% endif %}
                        </td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right text-gray-900 px-2">
                            {% if category.funds[fund.id] > 0 %}
                            &pound;{{ category.funds[fund.id]|number_format(2) }}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-medium text-gray-900 pl-4">&pound;{{ category.total|number_format(2) }}</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="{{ report.funds|length + 2 }}" class="py-4 text-sm text-gray-500 text-center">No payments in this period</td>
                    </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="bg-red-50">
                        <td class="py-2 text-sm font-bold text-gray-900 pr-4">Total Payments</td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right font-bold text-gray-900 px-2">&pound;{{ report.fund_totals[fund.id].payments|number_format(2) }}</td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-bold text-red-700 pl-4">&pound;{{ report.grand_totals.payments|number_format(2) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Transfers Section -->
        <div class="mb-8">
            <h3 class="text-lg font-bold text-gray-900 border-b-2 border-blue-500 pb-2 mb-4">TRANSFERS</h3>
            <table class="w-full min-w-max">
                <colgroup>
                    <col style="width: {{ label_col_width }};">
                    {% for fund in report.funds %}
                    <col style="width: {{ fund_col_width }};">
                    {% endfor %}
                    <col style="width: {{ total_col_width }};">
                </colgroup>
                <tbody>
                    <tr class="border-b border-gray-100">
                        <td class="py-2 text-sm text-gray-900 pr-4 min-w-[250px]">Transfers In</td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right text-gray-900 px-2 min-w-[100px]">
                            {% if report.fund_totals[fund.id].transfers_in > 0 %}
                            &pound;{{ report.fund_totals[fund.id].transfers_in|number_format(2) }}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-medium text-gray-900 pl-4 min-w-[100px]">
                            &pound;{{ report.grand_totals.transfers_in|number_format(2) }}
                        </td>
                    </tr>
                    <tr class="border-b border-gray-100">
                        <td class="py-2 text-sm text-gray-900 pr-4">Transfers Out</td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right text-gray-900 px-2">
                            {% if report.fund_totals[fund.id].transfers_out > 0 %}
                            &pound;{{ report.fund_totals[fund.id].transfers_out|number_format(2) }}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-medium text-gray-900 pl-4">
                            &pound;{{ report.grand_totals.transfers_out|number_format(2) }}
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="bg-blue-50">
                        <td class="py-2 text-sm font-bold text-gray-900 pr-4">Net Transfers</td>
                        {% for fund in report.funds %}
                        {% set net_transfer = report.fund_totals[fund.id].transfers_in - report.fund_totals[fund.id].transfers_out %}
                        <td class="py-2 text-sm text-right font-bold px-2 text-blue-700">
                            &pound;{{ net_transfer|number_format(2) }}
                        </td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-bold text-blue-700 pl-4">
                            &pound;{{ (report.grand_totals.transfers_in - report.grand_totals.transfers_out)|number_format(2) }}
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Closing Balances -->
        <div class="bg-blue-50 rounded-lg p-4">
            <table class="w-full min-w-max">
                <colgroup>
                    <col style="width: {{ label_col_width }};">
                    {% for fund in report.funds %}
                    <col style="width: {{ fund_col_width }};">
                    {% endfor %}
                    <col style="width: {{ total_col_width }};">
                </colgroup>
                <thead>
                    <tr class="text-sm text-gray-500">
                        <th class="text-left pb-2 pr-4 min-w-[250px]"></th>
                        {% for fund in report.funds %}
                        <th class="text-right pb-2 px-2 min-w-[100px]">{{ fund.name }}</th>
                        {% endfor %}
                        <th class="text-right pb-2 pl-4 min-w-[100px] font-bold">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="py-1 text-sm font-bold text-gray-900 pr-4">Net Movement</td>
                        {% for fund in report.funds %}
                        {% set net = report.fund_totals[fund.id].receipts - report.fund_totals[fund.id].payments + report.fund_totals[fund.id].transfers_in - report.fund_totals[fund.id].transfers_out %}
                        <td class="py-1 text-sm text-right font-bold px-2 {{ net >= 0 ? 'text-green-700' : 'text-red-700' }}">
                            &pound;{{ net|number_format(2) }}
                        </td>
                        {% endfor %}
                        {% set total_net = report.grand_totals.receipts - report.grand_totals.payments + report.grand_totals.transfers_in - report.grand_totals.transfers_out %}
                        <td class="py-1 text-sm text-right font-bold pl-4 {{ total_net >= 0 ? 'text-green-700' : 'text-red-700' }}">
                            &pound;{{ total_net|number_format(2) }}
                        </td>
                    </tr>
                    <tr class="border-t-2 border-blue-200">
                        <td class="py-2 text-sm font-bold text-gray-900 pr-4">Balance at {{ date_to }}</td>
                        {% for fund in report.funds %}
                        <td class="py-2 text-sm text-right font-bold text-gray-900 px-2">&pound;{{ report.fund_totals[fund.id].closing|number_format(2) }}</td>
                        {% endfor %}
                        <td class="py-2 text-sm text-right font-bold text-blue-700 pl-4">&pound;{{ report.grand_totals.closing|number_format(2) }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>
</div>

<div class="mt-4 flex justify-between items-center">
    <p class="text-sm text-gray-500">
        This report shows detailed operational category breakdown by fund.
    </p>
    <button onclick="window.print()" class="px-4 py-2 text-sm text-gray-700 hover:text-gray-900">
        Print Report
    </button>
</div>
{% endblock %}
