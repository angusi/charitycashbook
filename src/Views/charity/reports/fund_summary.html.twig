{% extends "layouts/charity.html.twig" %}

{% block title %}Fund Summary - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Fund Summary</h1>
    <p class="text-sm text-gray-500">{{ charity.name }}</p>
</div>

<!-- Date Filter -->
<div class="bg-white rounded-lg shadow mb-6 p-4">
    <form method="get" class="space-y-4">
        <div class="flex items-end space-x-4 flex-wrap gap-y-4">
            <div>
                <label for="date_from" class="block text-sm font-medium text-gray-700">From Date (optional)</label>
                <input type="date" name="date_from" id="date_from" value="{{ date_from }}"
                       class="mt-1 block rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            </div>
            <div>
                <label for="date_to" class="block text-sm font-medium text-gray-700">To Date</label>
                <input type="date" name="date_to" id="date_to" value="{{ date_to }}"
                       class="mt-1 block rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            </div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium">
                Update
            </button>
        </div>
        
        {# Quick date buttons #}
        <div class="flex flex-wrap gap-2 pt-2 border-t border-gray-200">
            <span class="text-sm text-gray-500 self-center mr-2">Quick select:</span>
            <button type="button" onclick="setDateRange('current_year')" 
                    class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">
                Current Financial Year
            </button>
            <button type="button" onclick="setDateRange('last_year')" 
                    class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">
                Last Financial Year
            </button>
            <button type="button" onclick="setDateRange('all_time')" 
                    class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">
                All Time (to today)
            </button>
        </div>
        
        {% if date_from %}
        <p class="text-xs text-gray-500 mt-2">
            Showing activity from {{ date_from }} to {{ date_to }}. Clear "From Date" for cumulative balances.
        </p>
        {% else %}
        <p class="text-xs text-gray-500 mt-2">
            Showing cumulative balances as of {{ date_to }}. Set "From Date" to see period-specific activity (to match R&P reports).
        </p>
        {% endif %}
    </form>
</div>

<script>
(function() {
    const yearEndMonth = {{ charity.year_end_month|default(3) }};
    const yearEndDay = {{ charity.year_end_day|default(31) }};
    
    function formatDate(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }
    
    function getFinancialYearDates(yearsAgo) {
        const today = new Date();
        const currentYear = today.getFullYear();
        const currentMonth = today.getMonth() + 1;
        const currentDay = today.getDate();
        
        // Determine which financial year we're in
        let fyEndYear = currentYear;
        if (currentMonth < yearEndMonth || (currentMonth === yearEndMonth && currentDay <= yearEndDay)) {
            // We're before this year's end, so FY ends this calendar year
        } else {
            // We're after this year's end, so FY ends next calendar year
            fyEndYear = currentYear + 1;
        }
        fyEndYear -= yearsAgo;
        
        const fyEnd = new Date(fyEndYear, yearEndMonth - 1, yearEndDay);
        const fyStart = new Date(fyEndYear - 1, yearEndMonth - 1, yearEndDay + 1);
        
        return { start: fyStart, end: fyEnd };
    }
    
    window.setDateRange = function(option) {
        const dateFromInput = document.getElementById('date_from');
        const dateToInput = document.getElementById('date_to');
        
        switch(option) {
            case 'current_year':
                const currentFY = getFinancialYearDates(0);
                dateFromInput.value = formatDate(currentFY.start);
                dateToInput.value = formatDate(new Date()); // Today
                break;
            case 'last_year':
                const lastFY = getFinancialYearDates(1);
                dateFromInput.value = formatDate(lastFY.start);
                dateToInput.value = formatDate(lastFY.end);
                break;
            case 'all_time':
                dateFromInput.value = '';
                dateToInput.value = formatDate(new Date());
                break;
        }
    };
})();
</script>

<!-- Fund Summary Table -->
<div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fund</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Receipts</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Payments</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Transfers In</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Transfers Out</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Balance</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% set total_receipts = 0 %}
            {% set total_payments = 0 %}
            {% set total_transfers_in = 0 %}
            {% set total_transfers_out = 0 %}
            {% set total_balance = 0 %}
            {% for fund in report.funds %}
                {% set total_receipts = total_receipts + fund.receipts %}
                {% set total_payments = total_payments + fund.payments %}
                {% set total_transfers_in = total_transfers_in + fund.transfers_in %}
                {% set total_transfers_out = total_transfers_out + fund.transfers_out %}
                {% set total_balance = total_balance + fund.balance %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ fund.name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 capitalize">{{ fund.fund_type }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-green-600">£{{ fund.receipts|number_format(2) }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-red-600">£{{ fund.payments|number_format(2) }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-blue-600">£{{ fund.transfers_in|number_format(2) }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-blue-600">£{{ fund.transfers_out|number_format(2) }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-medium text-gray-900">£{{ fund.balance|number_format(2) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-8 text-center text-gray-500">No funds found</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot class="bg-gray-50">
            <tr class="font-semibold">
                <td class="px-6 py-4 text-sm text-gray-900">Total</td>
                <td class="px-6 py-4"></td>
                <td class="px-6 py-4 text-sm text-right text-green-600">£{{ total_receipts|number_format(2) }}</td>
                <td class="px-6 py-4 text-sm text-right text-red-600">£{{ total_payments|number_format(2) }}</td>
                <td class="px-6 py-4 text-sm text-right text-blue-600">£{{ total_transfers_in|number_format(2) }}</td>
                <td class="px-6 py-4 text-sm text-right text-blue-600">£{{ total_transfers_out|number_format(2) }}</td>
                <td class="px-6 py-4 text-sm text-right text-gray-900">£{{ total_balance|number_format(2) }}</td>
            </tr>
        </tfoot>
    </table>
</div>

<div class="mt-4">
    <a href="/charity/{{ charity.id }}/reports" class="text-sm text-blue-600 hover:text-blue-800">← Back to Reports</a>
</div>
{% endblock %}
