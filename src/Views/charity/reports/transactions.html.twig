{% extends "layouts/charity.html.twig" %}

{% block title %}Transaction Report - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Transaction Report</h1>
    <p class="text-sm text-gray-500">{{ charity.name }}</p>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow mb-6 p-4">
    <form method="get" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div>
                <label for="date_from" class="block text-sm font-medium text-gray-700">From</label>
                <input type="date" name="date_from" id="date_from" value="{{ date_from }}"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            </div>
            <div>
                <label for="date_to" class="block text-sm font-medium text-gray-700">To</label>
                <input type="date" name="date_to" id="date_to" value="{{ date_to }}"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            </div>
            <div>
                <label for="fund_id" class="block text-sm font-medium text-gray-700">Fund</label>
                <select name="fund_id" id="fund_id"
                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    <option value="">All Funds</option>
                    {% for fund in funds %}
                        <option value="{{ fund.id }}" {{ fund_id == fund.id ? 'selected' : '' }}>{{ fund.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="type" class="block text-sm font-medium text-gray-700">Type</label>
                <select name="type" id="type"
                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    <option value="">All</option>
                    <option value="receipt" {{ type == 'receipt' ? 'selected' : '' }}>Receipts</option>
                    <option value="payment" {{ type == 'payment' ? 'selected' : '' }}>Payments</option>
                </select>
            </div>
            <div class="flex items-end">
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium">
                    Filter
                </button>
            </div>
        </div>
        
        {# Quick date range buttons #}
        <div class="flex flex-wrap gap-2 pt-2 border-t border-gray-200">
            <span class="text-sm text-gray-500 self-center mr-2">Quick select:</span>
            <button type="button" onclick="setDateRange('ytd')" 
                    class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">
                YTD
            </button>
            <button type="button" onclick="setDateRange('last_year')" 
                    class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">
                Last Year
            </button>
            <button type="button" onclick="setDateRange('two_years_ago')" 
                    class="px-3 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200">
                2 Years Ago
            </button>
        </div>
    </form>
</div>

<script>
(function() {
    const yearEndMonth = {{ charity.year_end_month|default(3) }};
    const yearEndDay = {{ charity.year_end_day|default(31) }};
    
    function getFinancialYearDates(yearsAgo) {
        const today = new Date();
        const currentYear = today.getFullYear();
        const currentMonth = today.getMonth() + 1;
        const currentDay = today.getDate();
        
        let fyEndYear = currentYear;
        if (currentMonth < yearEndMonth || (currentMonth === yearEndMonth && currentDay <= yearEndDay)) {
        } else {
            fyEndYear = currentYear + 1;
        }
        fyEndYear -= yearsAgo;
        
        const startDate = new Date(fyEndYear - 1, yearEndMonth - 1, yearEndDay);
        startDate.setDate(startDate.getDate() + 1);
        const endDate = new Date(fyEndYear, yearEndMonth - 1, yearEndDay);
        
        return { start: startDate, end: endDate };
    }
    
    function formatDate(date) {
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }
    
    window.setDateRange = function(range) {
        const dateFrom = document.getElementById('date_from');
        const dateTo = document.getElementById('date_to');
        let dates;
        const today = new Date();
        
        switch(range) {
            case 'ytd':
                dates = getFinancialYearDates(0);
                dates.end = today;
                break;
            case 'last_year':
                dates = getFinancialYearDates(1);
                break;
            case 'two_years_ago':
                dates = getFinancialYearDates(2);
                break;
        }
        
        if (dates) {
            dateFrom.value = formatDate(dates.start);
            dateTo.value = formatDate(dates.end);
        }
    };
})();
</script>

<!-- Summary -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm font-medium text-gray-500">Total Receipts</p>
        <p class="text-2xl font-semibold text-green-600">£{{ total_receipts|number_format(2) }}</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm font-medium text-gray-500">Total Payments</p>
        <p class="text-2xl font-semibold text-red-600">£{{ total_payments|number_format(2) }}</p>
    </div>
    <div class="bg-white rounded-lg shadow p-4">
        <p class="text-sm font-medium text-gray-500">Net</p>
        <p class="text-2xl font-semibold text-gray-900">£{{ (total_receipts - total_payments)|number_format(2) }}</p>
    </div>
</div>

<!-- Transactions Table -->
<div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fund</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for t in transactions %}
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ t.transaction_date }}</td>
                    <td class="px-6 py-4 text-sm text-gray-900">{{ t.description }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ t.fund_name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ t.category_name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right {{ t.transaction_type == 'receipt' ? 'text-green-600' : 'text-red-600' }}">
                        {{ t.transaction_type == 'receipt' ? '+' : '-' }}£{{ t.amount|number_format(2) }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-500">No transactions found</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a href="/charity/{{ charity.id }}/reports" class="text-sm text-blue-600 hover:text-blue-800">← Back to Reports</a>
</div>
{% endblock %}
