{% extends "layouts/charity.html.twig" %}

{% block title %}New {{ type|capitalize }} - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">New {{ type|capitalize }}</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>

    {% include 'components/flash.html.twig' %}

    <div class="bg-white rounded-lg shadow p-6">
        <form method="post" action="/charity/{{ charity.id }}/transactions" id="transaction-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="type" value="{{ type }}">
            <input type="hidden" name="split_mode" id="split_mode" value="0">

            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="transaction_date" class="block text-sm font-medium text-gray-700">Date *</label>
                        <input type="date" name="transaction_date" id="transaction_date" required
                               value="{{ "now"|date("Y-m-d") }}"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label for="amount" class="block text-sm font-medium text-gray-700">Amount *</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">£</span>
                            </div>
                            <input type="number" name="amount" id="amount" required min="0.01" step="0.01"
                                   class="block w-full pl-7 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                                   placeholder="0.00">
                        </div>
                    </div>
                </div>

                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700">Description *</label>
                    <input type="text" name="description" id="description" required maxlength="255"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                           placeholder="Enter a description">
                </div>

                <div>
                    <label for="reference" class="block text-sm font-medium text-gray-700">Reference</label>
                    <input type="text" name="reference" id="reference" maxlength="100"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                           placeholder="Cheque number, invoice ref, etc.">
                </div>

                <div>
                    <label for="category_id" class="block text-sm font-medium text-gray-700">Category *</label>
                    <select name="operational_category_id" id="category_id" required
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="">Select a category</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Simple mode: single fund -->
                <div id="simple-fund-section">
                    <div class="flex justify-between items-center">
                        <label for="fund_id" class="block text-sm font-medium text-gray-700">Fund *</label>
                        {% if funds|length > 1 %}
                        <button type="button" onclick="toggleSplitMode('fund')" class="text-xs text-blue-600 hover:text-blue-800">
                            Split across funds
                        </button>
                        {% endif %}
                    </div>
                    <select name="fund_id" id="fund_id"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="">Select a fund</option>
                        {% for fund in funds %}
                            <option value="{{ fund.id }}">{{ fund.name }} ({{ fund.fund_type }})</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Split mode: multiple funds -->
                <div id="split-fund-section" class="hidden">
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-sm font-medium text-gray-700">Fund Allocation *</label>
                        <button type="button" onclick="toggleSplitMode('fund')" class="text-xs text-blue-600 hover:text-blue-800">
                            Use single fund
                        </button>
                    </div>
                    <div id="fund-entries" class="space-y-2">
                        <!-- Fund entry rows added dynamically -->
                    </div>
                    <button type="button" onclick="addFundEntry()" class="mt-2 text-sm text-blue-600 hover:text-blue-800">
                        + Add fund
                    </button>
                    <div class="mt-2 text-sm">
                        <span class="text-gray-500">Allocated: £</span>
                        <span id="fund-total" class="font-medium">0.00</span>
                        <span class="text-gray-500"> / £</span>
                        <span id="fund-target" class="font-medium">0.00</span>
                        <span id="fund-remaining" class="text-gray-500"></span>
                    </div>
                </div>

                {% if cash_books is defined and cash_books|length > 0 %}
                <!-- Simple mode: single cashbook -->
                <div id="simple-cashbook-section">
                    <div class="flex justify-between items-center">
                        <label for="cash_book_id" class="block text-sm font-medium text-gray-700">Cash Book</label>
                        {% if cash_books|length > 1 %}
                        <button type="button" onclick="toggleSplitMode('cashbook')" class="text-xs text-blue-600 hover:text-blue-800">
                            Split across cashbooks
                        </button>
                        {% endif %}
                    </div>
                    <select name="cash_book_id" id="cash_book_id"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="">Not assigned</option>
                        {% for book in cash_books %}
                            <option value="{{ book.id }}">{{ book.name }} ({{ book.book_type|capitalize }})</option>
                        {% endfor %}
                    </select>
                    <p class="mt-1 text-xs text-gray-500">Optionally assign to a cash book for reconciliation</p>
                </div>

                <!-- Split mode: multiple cashbooks -->
                <div id="split-cashbook-section" class="hidden">
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-sm font-medium text-gray-700">Cashbook Allocation</label>
                        <button type="button" onclick="toggleSplitMode('cashbook')" class="text-xs text-blue-600 hover:text-blue-800">
                            Use single cashbook
                        </button>
                    </div>
                    <div id="cashbook-entries" class="space-y-2">
                        <!-- Cashbook entry rows added dynamically -->
                    </div>
                    <button type="button" onclick="addCashbookEntry()" class="mt-2 text-sm text-blue-600 hover:text-blue-800">
                        + Add cashbook
                    </button>
                    <div class="mt-2 text-sm">
                        <span class="text-gray-500">Allocated: £</span>
                        <span id="cashbook-total" class="font-medium">0.00</span>
                        <span class="text-gray-500"> / £</span>
                        <span id="cashbook-target" class="font-medium">0.00</span>
                        <span id="cashbook-remaining" class="text-gray-500"></span>
                    </div>
                </div>
                {% endif %}

                {% if type == 'receipt' %}
                    <div class="border-t border-gray-200 pt-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Gift Aid</h3>
                        
                        <div class="mb-4">
                            <div class="flex justify-between items-center">
                                <label for="donor_search" class="block text-sm font-medium text-gray-700">Donor</label>
                                <button type="button" onclick="openNewDonorModal()" class="text-xs text-blue-600 hover:text-blue-800">
                                    + New Donor
                                </button>
                            </div>
                            <div class="relative mt-1">
                                <input type="hidden" name="donor_id" id="donor_id" value="">
                                <input type="text" id="donor_search" autocomplete="off"
                                       class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                                       placeholder="Search donors...">
                            </div>
                            <p class="mt-1 text-xs text-gray-500">Type to search · ✓ = has active Gift Aid declaration</p>
                        </div>

                        <div class="space-y-3">
                            <label class="flex items-center">
                                <input type="checkbox" name="has_oneoff_declaration" value="1"
                                       class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-700">One-off Gift Aid declaration received</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="is_gasds" value="1"
                                       class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-700">GASDS (small cash donation, £30 or under)</span>
                            </label>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="mt-6 flex justify-end space-x-3">
                <a href="/charity/{{ charity.id }}/transactions"
                   class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white {{ type == 'receipt' ? 'bg-green-600 hover:bg-green-700' : 'bg-red-600 hover:bg-red-700' }}">
                    Save {{ type|capitalize }}
                </button>
            </div>
        </form>
    </div>
</div>

{% if type == 'receipt' %}
<!-- Fixed position dropdown for donor search -->
<div id="donor-dropdown" class="hidden fixed z-50 bg-white shadow-lg rounded-md border border-gray-200 max-h-48 overflow-auto">
    <!-- Results populated by JS -->
</div>

<!-- New Donor Modal -->
<div id="new-donor-modal" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-gray-500 opacity-50"></div>
    <div class="fixed inset-0 flex items-center justify-center">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <form id="new-donor-form" onsubmit="submitNewDonor(event)">
            <div class="px-6 py-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Add Donor</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Name *</label>
                        <input type="text" id="new-donor-name" required
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                               placeholder="Donor name">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Email</label>
                        <input type="email" id="new-donor-email"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                               placeholder="email@example.com">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Address Line 1</label>
                            <input type="text" id="new-donor-address1"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">City</label>
                            <input type="text" id="new-donor-city"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Postcode</label>
                        <input type="text" id="new-donor-postcode"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm w-32"
                               placeholder="AB1 2CD">
                    </div>
                    <div class="border-t pt-4">
                        <label class="flex items-center">
                            <input type="checkbox" id="new-donor-declaration" onchange="toggleDeclarationOptions()"
                                   class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <span class="ml-2 text-sm text-gray-700">Add Gift Aid declaration</span>
                        </label>
                        <div id="declaration-options" class="hidden ml-6 mt-2 space-y-1">
                            <label class="flex items-center">
                                <input type="radio" name="declaration_scope" value="today" checked
                                       class="border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-600">From today only</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="declaration_scope" value="past"
                                       class="border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-600">Including past 4 years</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div id="new-donor-error" class="hidden mt-4 p-3 bg-red-50 text-red-700 text-sm rounded-md"></div>
            </div>
            <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3 rounded-b-lg">
                <button type="button" onclick="closeNewDonorModal()"
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit" id="new-donor-submit"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                    Create & Select
                </button>
            </div>
        </form>
        </div>
    </div>
</div>
{% endif %}

<script>
const funds = {{ funds|json_encode|raw }};
const cashBooks = {{ cash_books is defined ? cash_books|json_encode|raw : '[]' }};

let fundSplitMode = false;
let cashbookSplitMode = false;
let fundEntryCount = 0;
let cashbookEntryCount = 0;

function toggleSplitMode(type) {
    if (type === 'fund') {
        fundSplitMode = !fundSplitMode;
        document.getElementById('simple-fund-section').classList.toggle('hidden', fundSplitMode);
        document.getElementById('split-fund-section').classList.toggle('hidden', !fundSplitMode);

        if (fundSplitMode) {
            // Clear simple mode and add first entry
            document.getElementById('fund_id').value = '';
            document.getElementById('fund_id').removeAttribute('required');
            if (fundEntryCount === 0) {
                addFundEntry();
                addFundEntry();
            }
            updateFundTotals();
        } else {
            // Restore single fund mode - clear split entries completely
            document.getElementById('fund_id').setAttribute('required', 'required');
            document.getElementById('fund-entries').innerHTML = '';
            fundEntryCount = 0;
        }
    } else if (type === 'cashbook') {
        cashbookSplitMode = !cashbookSplitMode;
        document.getElementById('simple-cashbook-section').classList.toggle('hidden', cashbookSplitMode);
        document.getElementById('split-cashbook-section').classList.toggle('hidden', !cashbookSplitMode);

        const cashBookSelect = document.getElementById('cash_book_id');
        if (cashbookSplitMode) {
            cashBookSelect.value = '';
            cashBookSelect.removeAttribute('required');
            if (cashbookEntryCount === 0) {
                addCashbookEntry();
                addCashbookEntry();
            }
            updateCashbookTotals();
        } else {
            // Restore single cashbook mode - clear split entries completely
            document.getElementById('cashbook-entries').innerHTML = '';
            cashbookEntryCount = 0;
        }
    }
    updateSplitMode();
}

function updateSplitMode() {
    document.getElementById('split_mode').value = (fundSplitMode || cashbookSplitMode) ? '1' : '0';
}

function addFundEntry() {
    const container = document.getElementById('fund-entries');
    const idx = fundEntryCount++;
    
    const row = document.createElement('div');
    row.className = 'flex gap-2 items-center';
    row.id = `fund-entry-${idx}`;
    row.innerHTML = `
        <select name="fund_entries[${idx}][fund_id]" required
                class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            <option value="">Select fund</option>
            ${funds.map(f => `<option value="${f.id}">${f.name}</option>`).join('')}
        </select>
        <div class="relative w-32">
            <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
                <span class="text-gray-500 sm:text-sm">£</span>
            </div>
            <input type="number" name="fund_entries[${idx}][amount]" step="0.01" min="0" required
                   onchange="updateFundTotals()" oninput="updateFundTotals()"
                   class="block w-full pl-6 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                   placeholder="0.00">
        </div>
        <button type="button" onclick="removeFundEntry(${idx})" class="text-red-500 hover:text-red-700">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    `;
    container.appendChild(row);
}

function removeFundEntry(idx) {
    const row = document.getElementById(`fund-entry-${idx}`);
    if (row) row.remove();
    updateFundTotals();
}

function addCashbookEntry() {
    const container = document.getElementById('cashbook-entries');
    const idx = cashbookEntryCount++;
    
    const row = document.createElement('div');
    row.className = 'flex gap-2 items-center';
    row.id = `cashbook-entry-${idx}`;
    row.innerHTML = `
        <select name="cashbook_entries[${idx}][cash_book_id]" required
                class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            <option value="">Select cashbook</option>
            ${cashBooks.map(cb => `<option value="${cb.id}">${cb.name}</option>`).join('')}
        </select>
        <div class="relative w-32">
            <div class="absolute inset-y-0 left-0 pl-2 flex items-center pointer-events-none">
                <span class="text-gray-500 sm:text-sm">£</span>
            </div>
            <input type="number" name="cashbook_entries[${idx}][amount]" step="0.01" min="0" required
                   onchange="updateCashbookTotals()" oninput="updateCashbookTotals()"
                   class="block w-full pl-6 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                   placeholder="0.00">
        </div>
        <button type="button" onclick="removeCashbookEntry(${idx})" class="text-red-500 hover:text-red-700">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    `;
    container.appendChild(row);
}

function removeCashbookEntry(idx) {
    const row = document.getElementById(`cashbook-entry-${idx}`);
    if (row) row.remove();
    updateCashbookTotals();
}

function updateFundTotals() {
    const target = parseFloat(document.getElementById('amount').value) || 0;
    const inputs = document.querySelectorAll('#fund-entries input[type="number"]');
    let total = 0;
    inputs.forEach(input => {
        total += parseFloat(input.value) || 0;
    });
    
    document.getElementById('fund-total').textContent = total.toFixed(2);
    document.getElementById('fund-target').textContent = target.toFixed(2);
    
    const remaining = target - total;
    const remainingEl = document.getElementById('fund-remaining');
    if (Math.abs(remaining) > 0.01) {
        remainingEl.textContent = ` (${remaining > 0 ? '+' : ''}${remaining.toFixed(2)} remaining)`;
        remainingEl.className = remaining > 0 ? 'text-orange-500' : 'text-red-500';
    } else {
        remainingEl.textContent = ' ✓';
        remainingEl.className = 'text-green-500';
    }
}

function updateCashbookTotals() {
    const target = parseFloat(document.getElementById('amount').value) || 0;
    const inputs = document.querySelectorAll('#cashbook-entries input[type="number"]');
    let total = 0;
    inputs.forEach(input => {
        total += parseFloat(input.value) || 0;
    });
    
    document.getElementById('cashbook-total').textContent = total.toFixed(2);
    document.getElementById('cashbook-target').textContent = target.toFixed(2);
    
    const remaining = target - total;
    const remainingEl = document.getElementById('cashbook-remaining');
    if (Math.abs(remaining) > 0.01) {
        remainingEl.textContent = ` (${remaining > 0 ? '+' : ''}${remaining.toFixed(2)} remaining)`;
        remainingEl.className = remaining > 0 ? 'text-orange-500' : 'text-red-500';
    } else {
        remainingEl.textContent = ' ✓';
        remainingEl.className = 'text-green-500';
    }
}

// Update totals when amount changes
document.getElementById('amount').addEventListener('input', function() {
    if (fundSplitMode) updateFundTotals();
    if (cashbookSplitMode) updateCashbookTotals();
});

{% if type == 'receipt' %}
// Donor search functionality
const donors = {{ donors|json_encode|raw }};
const donorSearch = document.getElementById('donor_search');
const donorDropdown = document.getElementById('donor-dropdown');
const donorIdInput = document.getElementById('donor_id');

function truncate(str, maxLen) {
    if (!str) return '';
    return str.length > maxLen ? str.substring(0, maxLen) + '...' : str;
}

function positionDropdown() {
    const rect = donorSearch.getBoundingClientRect();
    donorDropdown.style.left = rect.left + 'px';
    donorDropdown.style.top = (rect.bottom + 4) + 'px';
    donorDropdown.style.width = rect.width + 'px';
}

function showDropdown() {
    positionDropdown();
    donorDropdown.classList.remove('hidden');
}

function hideDropdown() {
    donorDropdown.classList.add('hidden');
}

function renderDonorResults(results) {
    if (results.length === 0) {
        donorDropdown.innerHTML = '<div class="px-3 py-2 text-sm text-gray-500">No donors found</div>';
    } else {
        donorDropdown.innerHTML = results.map(d => `
            <div class="donor-option px-3 py-2 hover:bg-gray-100 cursor-pointer" data-id="${d.id}" data-name="${d.name.replace(/"/g, '&quot;')}">
                <div class="text-sm font-medium text-gray-900">
                    ${d.name}
                    ${d.has_active_declaration ? '<span class="text-green-600 ml-1">✓</span>' : ''}
                </div>
                ${d.notes ? `<div class="text-xs text-gray-500">${truncate(d.notes, 60)}</div>` : ''}
            </div>
        `).join('');
    }
    showDropdown();
}

function filterDonors(query) {
    const q = query.toLowerCase().trim();
    if (q === '') {
        return donors.slice(0, 10);
    }
    return donors.filter(d =>
        d.name.toLowerCase().includes(q) ||
        (d.notes && d.notes.toLowerCase().includes(q))
    ).slice(0, 20);
}

function selectDonor(id, name) {
    donorIdInput.value = id;
    donorSearch.value = name;
    hideDropdown();
}

function clearDonor() {
    donorIdInput.value = '';
    donorSearch.value = '';
}

donorSearch.addEventListener('input', function() {
    const results = filterDonors(this.value);
    renderDonorResults(results);
});

donorSearch.addEventListener('focus', function() {
    const results = filterDonors(this.value);
    renderDonorResults(results);
});

donorSearch.addEventListener('blur', function() {
    // Delay hiding to allow click on option
    setTimeout(hideDropdown, 200);
});

donorSearch.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        hideDropdown();
    }
});

donorDropdown.addEventListener('click', function(e) {
    const option = e.target.closest('.donor-option');
    if (option) {
        selectDonor(option.dataset.id, option.dataset.name);
    }
});

// Clear button - clear if user empties the field
donorSearch.addEventListener('change', function() {
    if (this.value === '') {
        clearDonor();
    }
});

// Reposition on scroll/resize
window.addEventListener('scroll', function() {
    if (!donorDropdown.classList.contains('hidden')) {
        positionDropdown();
    }
}, true);
window.addEventListener('resize', function() {
    if (!donorDropdown.classList.contains('hidden')) {
        positionDropdown();
    }
});

// New Donor Modal
const newDonorModal = document.getElementById('new-donor-modal');

function toggleDeclarationOptions() {
    const checkbox = document.getElementById('new-donor-declaration');
    const options = document.getElementById('declaration-options');
    options.classList.toggle('hidden', !checkbox.checked);
}

function openNewDonorModal() {
    hideDropdown();
    newDonorModal.classList.remove('hidden');
    document.getElementById('new-donor-name').focus();
}

function closeNewDonorModal() {
    newDonorModal.classList.add('hidden');
    document.getElementById('new-donor-form').reset();
    document.getElementById('new-donor-error').classList.add('hidden');
    document.getElementById('declaration-options').classList.add('hidden');
}

async function submitNewDonor(event) {
    event.preventDefault();

    const submitBtn = document.getElementById('new-donor-submit');
    const errorDiv = document.getElementById('new-donor-error');

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating...';
    errorDiv.classList.add('hidden');

    const addDeclaration = document.getElementById('new-donor-declaration').checked;
    const declarationScope = document.querySelector('input[name="declaration_scope"]:checked');

    const data = {
        name: document.getElementById('new-donor-name').value,
        email: document.getElementById('new-donor-email').value,
        address_line1: document.getElementById('new-donor-address1').value,
        city: document.getElementById('new-donor-city').value,
        postcode: document.getElementById('new-donor-postcode').value,
        add_declaration: addDeclaration,
        covers_past: addDeclaration && declarationScope && declarationScope.value === 'past',
        csrf_token: '{{ csrf_token }}'
    };

    try {
        const response = await fetch('/charity/{{ charity.id }}/donors/quick-create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
            // Add new donor to local array
            donors.push({
                id: result.donor.id,
                name: result.donor.name,
                notes: null,
                has_active_declaration: result.donor.has_declaration
            });

            // Select the new donor
            selectDonor(result.donor.id, result.donor.name);
            closeNewDonorModal();
        } else {
            errorDiv.textContent = result.error || 'Failed to create donor';
            errorDiv.classList.remove('hidden');
        }
    } catch (err) {
        errorDiv.textContent = 'An error occurred. Please try again.';
        errorDiv.classList.remove('hidden');
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Create & Select';
}

// Close modal on Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !newDonorModal.classList.contains('hidden')) {
        closeNewDonorModal();
    }
});
{% endif %}
</script>
{% endblock %}
