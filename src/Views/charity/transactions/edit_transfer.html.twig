{% extends "layouts/charity.html.twig" %}

{% block title %}Edit Transfer - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Edit Fund Transfer</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>

    {% include 'components/flash.html.twig' %}

    <div class="bg-white rounded-lg shadow p-6">
        <form method="post" action="/charity/{{ charity.id }}/transactions/{{ transaction.id }}" id="transaction-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="type" value="transfer">
            <input type="hidden" name="_method" value="PUT">

            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="transaction_date" class="block text-sm font-medium text-gray-700">Date *</label>
                        <input type="date" name="transaction_date" id="transaction_date" required
                               value="{{ transaction.transaction_date }}"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label for="amount" class="block text-sm font-medium text-gray-700">Amount *</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">&pound;</span>
                            </div>
                            <input type="number" name="amount" id="amount" required min="0.01" step="0.01"
                                   value="{{ transaction.amount }}"
                                   class="block w-full pl-7 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                                   placeholder="0.00">
                        </div>
                    </div>
                </div>

                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700">Description *</label>
                    <input type="text" name="description" id="description" required maxlength="255"
                           value="{{ transaction.description }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                           placeholder="e.g., Transfer from General to Projects">
                </div>

                <div>
                    <label for="reference" class="block text-sm font-medium text-gray-700">Reference</label>
                    <input type="text" name="reference" id="reference" maxlength="100"
                           value="{{ transaction.reference }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                           placeholder="Optional reference">
                </div>

                <!-- Fund Allocation -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fund Allocation *</label>
                    <p class="text-xs text-gray-500 mb-3">Enter the source fund(s) with negative amounts and destination fund(s) with positive amounts. Totals must balance to zero.</p>

                    <div id="fund-entries" class="space-y-2">
                        <!-- Fund entry rows will be added here -->
                    </div>

                    <button type="button" onclick="addFundEntry()" class="mt-2 text-sm text-blue-600 hover:text-blue-800">
                        + Add fund
                    </button>

                    <div class="mt-3 p-3 bg-gray-50 rounded-md">
                        <div class="flex justify-between text-sm">
                            <span class="font-medium">Total:</span>
                            <span id="fund-total" class="font-medium">£0.00</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Must balance to £0.00</p>
                    </div>
                </div>

                <div class="flex justify-end space-x-3">
                    <a href="/charity/{{ charity.id }}/transactions/{{ transaction.id }}" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        Cancel
                    </a>
                    <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                        Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
const funds = {{ funds|json_encode|raw }};
const existingFundEntries = {{ transaction.fund_entries|json_encode|raw }};
let fundEntryCount = 0;

function addFundEntry(fundId = '', amount = '') {
    const container = document.getElementById('fund-entries');
    const entryId = fundEntryCount++;

    const div = document.createElement('div');
    div.className = 'flex gap-2 items-start';
    div.id = `fund-entry-${entryId}`;

    div.innerHTML = `
        <select name="fund_entries[${entryId}][fund_id]" required
                class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
            <option value="">Select fund</option>
            ${funds.map(f => `<option value="${f.id}" ${f.id == fundId ? 'selected' : ''}>${f.name}</option>`).join('')}
        </select>
        <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-gray-500 sm:text-sm">&pound;</span>
            </div>
            <input type="number" name="fund_entries[${entryId}][amount]" required step="0.01"
                   value="${amount}"
                   onchange="updateFundTotals()"
                   class="block w-full pl-7 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                   placeholder="0.00 (- for source, + for dest)">
        </div>
        <button type="button" onclick="removeFundEntry(${entryId})"
                class="px-2 py-2 text-red-600 hover:text-red-800">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    `;

    container.appendChild(div);
    updateFundTotals();
}

function removeFundEntry(entryId) {
    const entry = document.getElementById(`fund-entry-${entryId}`);
    if (entry) {
        entry.remove();
        updateFundTotals();
    }
}

function updateFundTotals() {
    const entries = document.querySelectorAll('[name^="fund_entries"][name$="[amount]"]');
    let total = 0;

    entries.forEach(input => {
        const value = parseFloat(input.value) || 0;
        total += value;
    });

    const totalDisplay = document.getElementById('fund-total');
    totalDisplay.textContent = `£${total.toFixed(2)}`;

    // Highlight if not balanced
    if (Math.abs(total) > 0.01) {
        totalDisplay.classList.add('text-red-600');
        totalDisplay.classList.remove('text-green-600');
    } else {
        totalDisplay.classList.add('text-green-600');
        totalDisplay.classList.remove('text-red-600');
    }
}

// Initialize with existing entries
document.addEventListener('DOMContentLoaded', function() {
    if (existingFundEntries && existingFundEntries.length > 0) {
        existingFundEntries.forEach(entry => {
            addFundEntry(entry.fund_id, entry.amount);
        });
    } else {
        // Add 2 empty entries if no existing ones
        addFundEntry();
        addFundEntry();
    }
});

// Form validation
document.getElementById('transaction-form').addEventListener('submit', function(e) {
    const entries = document.querySelectorAll('[name^="fund_entries"][name$="[amount]"]');
    let total = 0;

    entries.forEach(input => {
        total += parseFloat(input.value) || 0;
    });

    if (Math.abs(total) > 0.01) {
        e.preventDefault();
        alert('Fund entries must balance to £0.00. Current total: £' + total.toFixed(2));
        return false;
    }

    if (entries.length < 2) {
        e.preventDefault();
        alert('Transfers must have at least 2 fund entries (source and destination).');
        return false;
    }
});
</script>
{% endblock %}
