{% extends "layouts/charity.html.twig" %}

{% block title %}Edit Transaction - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Edit Transaction</h1>
        <p class="text-sm text-gray-500">{{ charity.name }}</p>
    </div>

    {% include 'components/flash.html.twig' %}

    <div class="bg-white rounded-lg shadow p-6">
        <form method="post" action="/charity/{{ charity.id }}/transactions/{{ transaction.id }}" id="transaction-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="split_mode" id="split_mode" value="{{ (transaction.fund_entries|length > 1 or transaction.category_entries|length > 1 or transaction.cashbook_entries|length > 1) ? '1' : '0' }}">

            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="transaction_date" class="block text-sm font-medium text-gray-700">Date *</label>
                        <input type="date" name="transaction_date" id="transaction_date" required
                               value="{{ transaction.transaction_date }}"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label for="amount" class="block text-sm font-medium text-gray-700">Amount *</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-500 sm:text-sm">£</span>
                            </div>
                            <input type="number" name="amount" id="amount" required min="0.01" step="0.01"
                                   value="{{ transaction.amount }}"
                                   class="block w-full pl-7 rounded-md border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                    </div>
                </div>

                <div>
                    <label for="description" class="block text-sm font-medium text-gray-700">Description *</label>
                    <input type="text" name="description" id="description" required maxlength="255"
                           value="{{ transaction.description }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>

                <div>
                    <label for="reference" class="block text-sm font-medium text-gray-700">Reference</label>
                    <input type="text" name="reference" id="reference" maxlength="100"
                           value="{{ transaction.reference }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>

                <!-- Simple mode: single category -->
                <div id="simple-category-section" class="{{ transaction.category_entries|length > 1 ? 'hidden' : '' }}">
                    <div class="flex justify-between items-center">
                        <label for="category_id" class="block text-sm font-medium text-gray-700">Category *</label>
                        {% if categories|length > 1 %}
                        <button type="button" onclick="toggleSplitMode('category')" class="text-xs text-blue-600 hover:text-blue-800">
                            Split across categories
                        </button>
                        {% endif %}
                    </div>
                    <select name="operational_category_id" id="category_id" {{ transaction.category_entries|length > 1 ? '' : 'required' }}
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="">Select a category</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}" {{ transaction.operational_category_id == category.id ? 'selected' : '' }}>
                                {{ category.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Split mode: multiple categories -->
                <div id="split-category-section" class="{{ transaction.category_entries|length > 1 ? '' : 'hidden' }}">
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-sm font-medium text-gray-700">Category Allocation *</label>
                        <button type="button" onclick="toggleSplitMode('category')" class="text-xs text-blue-600 hover:text-blue-800">
                            Use single category
                        </button>
                    </div>
                    <div id="category-entries" class="space-y-2">
                        <!-- Category entry rows added dynamically -->
                    </div>
                    <button type="button" onclick="addCategoryEntry()" class="mt-2 text-sm text-blue-600 hover:text-blue-800">
                        + Add category
                    </button>
                    <div class="mt-2 text-sm">
                        <span class="text-gray-500">Allocated: £</span>
                        <span id="category-total" class="font-medium">0.00</span>
                        <span class="text-gray-500"> / £</span>
                        <span id="category-target" class="font-medium">0.00</span>
                        <span id="category-remaining" class="text-gray-500"></span>
                    </div>
                </div>

                <!-- Simple mode: single fund -->
                <div id="simple-fund-section" class="{{ transaction.fund_entries|length > 1 ? 'hidden' : '' }}">
                    <div class="flex justify-between items-center">
                        <label for="fund_id" class="block text-sm font-medium text-gray-700">Fund *</label>
                        {% if funds|length > 1 %}
                        <button type="button" onclick="toggleSplitMode('fund')" class="text-xs text-blue-600 hover:text-blue-800">
                            Split across funds
                        </button>
                        {% endif %}
                    </div>
                    <select name="fund_id" id="fund_id" {{ transaction.fund_entries|length > 1 ? '' : 'required' }}
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="">Select a fund</option>
                        {% for fund in funds %}
                            <option value="{{ fund.id }}" {{ transaction.fund_id == fund.id ? 'selected' : '' }}>
                                {{ fund.name }} ({{ fund.fund_type }})
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Split mode: multiple funds -->
                <div id="split-fund-section" class="{{ transaction.fund_entries|length > 1 ? '' : 'hidden' }}">
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-sm font-medium text-gray-700">Fund Allocation *</label>
                        <button type="button" onclick="toggleSplitMode('fund')" class="text-xs text-blue-600 hover:text-blue-800">
                            Use single fund
                        </button>
                    </div>
                    <div id="fund-entries" class="space-y-2">
                        <!-- Fund entry rows added dynamically -->
                    </div>
                    <button type="button" onclick="addFundEntry()" class="mt-2 text-sm text-blue-600 hover:text-blue-800">
                        + Add fund
                    </button>
                    <div class="mt-2 text-sm">
                        <span class="text-gray-500">Allocated: £</span>
                        <span id="fund-total" class="font-medium">0.00</span>
                        <span class="text-gray-500"> / £</span>
                        <span id="fund-target" class="font-medium">0.00</span>
                        <span id="fund-remaining" class="text-gray-500"></span>
                    </div>
                </div>

                {% if cash_books is defined and cash_books|length > 0 %}
                <!-- Simple mode: single cashbook -->
                <div id="simple-cashbook-section" class="{{ transaction.cashbook_entries|length > 1 ? 'hidden' : '' }}">
                    <div class="flex justify-between items-center">
                        <label for="cash_book_id" class="block text-sm font-medium text-gray-700">Cash Book</label>
                        {% if cash_books|length > 1 %}
                        <button type="button" onclick="toggleSplitMode('cashbook')" class="text-xs text-blue-600 hover:text-blue-800">
                            Split across cashbooks
                        </button>
                        {% endif %}
                    </div>
                    <select name="cash_book_id" id="cash_book_id"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        <option value="">Not assigned</option>
                        {% for book in cash_books %}
                            <option value="{{ book.id }}" {{ transaction.cash_book_id == book.id ? 'selected' : '' }}>
                                {{ book.name }} ({{ book.book_type|capitalize }})
                            </option>
                        {% endfor %}
                    </select>
                    <p class="mt-1 text-xs text-gray-500">Optionally assign to a cash book for reconciliation</p>
                </div>

                <!-- Split mode: multiple cashbooks -->
                <div id="split-cashbook-section" class="{{ transaction.cashbook_entries|length > 1 ? '' : 'hidden' }}">
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-sm font-medium text-gray-700">Cashbook Allocation</label>
                        <button type="button" onclick="toggleSplitMode('cashbook')" class="text-xs text-blue-600 hover:text-blue-800">
                            Use single cashbook
                        </button>
                    </div>
                    <div id="cashbook-entries" class="space-y-2">
                        <!-- Cashbook entry rows added dynamically -->
                    </div>
                    <button type="button" onclick="addCashbookEntry()" class="mt-2 text-sm text-blue-600 hover:text-blue-800">
                        + Add cashbook
                    </button>
                    <div class="mt-2 text-sm">
                        <span class="text-gray-500">Allocated: £</span>
                        <span id="cashbook-total" class="font-medium">0.00</span>
                        <span class="text-gray-500"> / £</span>
                        <span id="cashbook-target" class="font-medium">0.00</span>
                        <span id="cashbook-remaining" class="text-gray-500"></span>
                    </div>
                </div>
                {% endif %}

                {% if transaction.transaction_type == 'receipt' %}
                    <div class="border-t border-gray-200 pt-6">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">Gift Aid</h3>
                        
                        {% if transaction.giftaid_status == 'claimed' %}
                        <!-- Claimed transaction warning -->
                        <div class="mb-4 p-4 bg-amber-50 border border-amber-200 rounded-md">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                                <div class="ml-3">
                                    <h3 class="text-sm font-medium text-amber-800">Transaction Claimed</h3>
                                    <p class="mt-1 text-sm text-amber-700">
                                        This transaction was included in a Gift Aid claim. You can edit the description and reference, 
                                        but the amount, date, and donor cannot be changed.
                                    </p>
                                    <p class="mt-2 text-sm text-amber-700">
                                        If the claimed amount was incorrect, 
                                        <a href="/charity/{{ charity.id }}/giftaid/corrections/create?transaction_id={{ transaction.id }}" 
                                           class="font-medium underline hover:text-amber-800">add a correction</a> 
                                        to adjust a future claim.
                                    </p>
                                </div>
                            </div>
                        </div>
                        {% else %}
                        
                        <!-- Gift Aid Intent Toggle -->
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Gift Aid Eligible?</label>
                            <input type="hidden" name="giftaid_eligibility_override" id="giftaid_eligibility_override" 
                                   value="{{ transaction.giftaid_eligibility_override }}">
                            {% set isPartial = transaction.giftaid_amount is not null and transaction.giftaid_amount != transaction.amount %}
                            <div class="inline-flex rounded-md shadow-sm" role="group">
                                <button type="button" id="giftaid-no-btn"
                                        class="px-4 py-2 text-sm font-medium rounded-l-md border
                                               {{ transaction.giftaid_eligibility_override == 'not_eligible' ? 'bg-red-600 text-white border-red-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50' }}
                                               focus:z-10 focus:ring-2 focus:ring-red-500 focus:border-red-500">
                                    No
                                </button>
                                <button type="button" id="giftaid-partial-btn"
                                        class="px-4 py-2 text-sm font-medium border-t border-b
                                               {{ isPartial ? 'bg-yellow-500 text-white border-yellow-500' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50' }}
                                               focus:z-10 focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                                    Partial
                                </button>
                                <button type="button" id="giftaid-yes-btn"
                                        class="px-4 py-2 text-sm font-medium rounded-r-md border-t border-b border-r
                                               {{ transaction.giftaid_eligibility_override == 'eligible' and not isPartial ? 'bg-green-600 text-white border-green-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50' }}
                                               focus:z-10 focus:ring-2 focus:ring-green-500 focus:border-green-500">
                                    Yes
                                </button>
                            </div>
                            <p id="giftaid-intent-hint" class="mt-1 text-xs text-gray-500">
                                {% if transaction.giftaid_status == 'eligible' %}
                                    Eligible for Gift Aid.
                                {% elseif transaction.giftaid_status == 'pending_donor' %}
                                    Select a donor to complete Gift Aid setup.
                                {% elseif transaction.giftaid_status == 'pending_declaration' %}
                                    Donor needs a Gift Aid declaration.
                                {% elseif transaction.giftaid_status == 'excluded' %}
                                    This receipt will not be claimed for Gift Aid.
                                {% endif %}
                            </p>
                        </div>
                        {% endif %}
                        
                        <!-- Donor selection - always visible for receipts -->
                        <div class="mb-4">
                            <div class="flex justify-between items-center">
                                <label for="donor_search" class="block text-sm font-medium text-gray-700">Donor</label>
                                {% if transaction.giftaid_status != 'claimed' %}
                                <button type="button" onclick="openNewDonorModal()" class="text-xs text-blue-600 hover:text-blue-800">
                                    + New Donor
                                </button>
                                {% endif %}
                            </div>
                            <div class="relative mt-1">
                                <input type="hidden" name="donor_id" id="donor_id" value="{{ transaction.donor_id }}">
                                <input type="text" id="donor_search" autocomplete="off"
                                       class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm {{ transaction.giftaid_status == 'claimed' ? 'bg-gray-100' : '' }}"
                                       placeholder="Search donors..."
                                       value="{{ transaction.donor_name }}"
                                       {{ transaction.giftaid_status == 'claimed' ? 'readonly' : '' }}>
                            </div>
                            <p class="mt-1 text-xs text-gray-500">Type to search · ✓ = has active Gift Aid declaration</p>
                        </div>
                        
                        <!-- Gift Aid options - shown when intent is Yes or Partial -->
                        <div id="giftaid-details-section" class="{{ transaction.giftaid_eligibility_override == 'not_eligible' ? 'hidden' : '' }}">
                        <div class="space-y-3">
                            <label class="flex items-center">
                                <input type="checkbox" name="has_oneoff_declaration" value="1"
                                       {{ transaction.has_oneoff_declaration ? 'checked' : '' }}
                                       {{ transaction.giftaid_status == 'claimed' ? 'disabled' : '' }}
                                       class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-700">One-off Gift Aid declaration received</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="is_gasds" value="1"
                                       {{ transaction.giftaid_status == 'gasds' ? 'checked' : '' }}
                                       class="rounded border-gray-300 text-purple-600 shadow-sm focus:border-purple-500 focus:ring-purple-500">
                                <span class="ml-2 text-sm text-gray-700">GASDS (small cash donation, £30 or under)</span>
                            </label>
                        </div>
                        
                        {% if transaction.giftaid_status != 'claimed' %}
                        <!-- Partial Gift Aid section -->
                        <div id="partial-giftaid-section" class="{{ isPartial ? '' : 'hidden' }} mt-4 pt-4 border-t border-gray-200">
                            <div class="p-3 bg-gray-50 rounded-md mb-3" id="category-breakdown">
                                <!-- Populated by JS when in split-category mode -->
                            </div>
                            
                            <div class="flex items-end gap-3">
                                <div class="flex-1">
                                    <label for="giftaid_amount" class="block text-sm font-medium text-gray-700">
                                        Gift Aid eligible amount
                                    </label>
                                    <div class="mt-1 relative rounded-md shadow-sm">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <span class="text-gray-500 sm:text-sm">£</span>
                                        </div>
                                        <input type="number" name="giftaid_amount" id="giftaid_amount" step="0.01" min="0"
                                               value="{{ transaction.giftaid_amount }}"
                                               class="block w-full pl-7 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                                               placeholder="0.00">
                                    </div>
                                </div>
                                <button type="button" id="use-suggested-btn" onclick="useSuggestedGiftAidAmount()" 
                                        class="hidden px-3 py-2 text-sm text-blue-600 border border-blue-300 rounded-md hover:bg-blue-50">
                                    Use suggested
                                </button>
                            </div>
                            <p class="mt-1 text-xs text-gray-500">
                                Enter the portion of the receipt that qualifies for Gift Aid
                            </p>
                            <p id="giftaid-tax-preview" class="mt-1 text-xs text-green-600 {{ transaction.giftaid_amount ? '' : 'hidden' }}">
                                Tax relief: £<span id="giftaid-tax-amount">{{ transaction.giftaid_amount ? (transaction.giftaid_amount * 0.25)|number_format(2) : '0.00' }}</span>
                            </p>
                        </div>
                        {% else %}
                        <!-- Show claimed amount (read-only) -->
                        <div class="mt-4 pt-4 border-t border-gray-200">
                            <p class="text-sm text-gray-600">
                                <span class="font-medium">Claimed amount:</span> 
                                £{{ transaction.giftaid_amount|number_format(2) }}
                                {% if transaction.giftaid_amount != transaction.amount %}
                                    <span class="text-gray-500">(of £{{ transaction.amount|number_format(2) }} total)</span>
                                {% endif %}
                            </p>
                        </div>
                        {% endif %}
                        </div><!-- end giftaid-details-section -->
                    </div>
                {% endif %}
            </div>

            <div class="mt-6 flex justify-end space-x-3">
                <a href="/charity/{{ charity.id }}/transactions/{{ transaction.id }}"
                   class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

{% if transaction.transaction_type == 'receipt' %}
<!-- Fixed position dropdown for donor search -->
<div id="donor-dropdown" class="hidden fixed z-50 bg-white shadow-lg rounded-md border border-gray-200 max-h-48 overflow-auto">
    <!-- Results populated by JS -->
</div>

<!-- New Donor Modal -->
<div id="new-donor-modal" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-gray-500 opacity-50"></div>
    <div class="fixed inset-0 flex items-center justify-center">
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <form id="new-donor-form" onsubmit="submitNewDonor(event)">
            <div class="px-6 py-4">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Add Donor</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Name *</label>
                        <input type="text" id="new-donor-name" required
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                               placeholder="Donor name">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Email</label>
                        <input type="email" id="new-donor-email"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                               placeholder="email@example.com">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Address Line 1</label>
                            <input type="text" id="new-donor-address1"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700">City</label>
                            <input type="text" id="new-donor-city"
                                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Postcode</label>
                        <input type="text" id="new-donor-postcode"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm w-32"
                               placeholder="AB1 2CD">
                    </div>
                    <div class="border-t pt-4">
                        <label class="flex items-center">
                            <input type="checkbox" id="new-donor-declaration" onchange="toggleDeclarationOptions()"
                                   class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-500 focus:ring-blue-500">
                            <span class="ml-2 text-sm text-gray-700">Add Gift Aid declaration</span>
                        </label>
                        <div id="declaration-options" class="hidden ml-6 mt-2 space-y-1">
                            <label class="flex items-center">
                                <input type="radio" name="declaration_scope" value="today" checked
                                       class="border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-600">From today only</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="declaration_scope" value="past"
                                       class="border-gray-300 text-blue-600 focus:ring-blue-500">
                                <span class="ml-2 text-sm text-gray-600">Including past 4 years</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div id="new-donor-error" class="hidden mt-4 p-3 bg-red-50 text-red-700 text-sm rounded-md"></div>
            </div>
            <div class="px-6 py-4 bg-gray-50 flex justify-end space-x-3 rounded-b-lg">
                <button type="button" onclick="closeNewDonorModal()"
                        class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancel
                </button>
                <button type="submit" id="new-donor-submit"
                        class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                    Create & Select
                </button>
            </div>
        </form>
        </div>
    </div>
</div>
{% endif %}

<script>
const funds = {{ funds|json_encode|raw }};
const categories = {{ categories|json_encode|raw }};
const cashBooks = {{ cash_books is defined ? cash_books|json_encode|raw : '[]' }};
const existingFundEntries = {{ transaction.fund_entries|json_encode|raw }};
const existingCategoryEntries = {{ transaction.category_entries|default([])|json_encode|raw }};
const existingCashbookEntries = {{ transaction.cashbook_entries|default([])|json_encode|raw }};

// HTML escape function to prevent XSS
function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

let fundSplitMode = existingFundEntries.length > 1;
let categorySplitMode = existingCategoryEntries.length > 1;
let cashbookSplitMode = existingCashbookEntries.length > 1;
let fundEntryCount = 0;
let categoryEntryCount = 0;
let cashbookEntryCount = 0;

function toggleSplitMode(type) {
    if (type === 'fund') {
        fundSplitMode = !fundSplitMode;
        document.getElementById('simple-fund-section').classList.toggle('hidden', fundSplitMode);
        document.getElementById('split-fund-section').classList.toggle('hidden', !fundSplitMode);

        if (fundSplitMode) {
            document.getElementById('fund_id').value = '';
            document.getElementById('fund_id').removeAttribute('required');
            if (fundEntryCount === 0) {
                addFundEntry();
                addFundEntry();
            }
            updateFundTotals();
        } else {
            // Restore single fund mode - clear split entries completely
            document.getElementById('fund_id').setAttribute('required', 'required');
            document.getElementById('fund-entries').innerHTML = '';
            fundEntryCount = 0;
        }
    } else if (type === 'category') {
        categorySplitMode = !categorySplitMode;
        document.getElementById('simple-category-section').classList.toggle('hidden', categorySplitMode);
        document.getElementById('split-category-section').classList.toggle('hidden', !categorySplitMode);

        if (categorySplitMode) {
            document.getElementById('category_id').value = '';
            document.getElementById('category_id').removeAttribute('required');
            if (categoryEntryCount === 0) {
                addCategoryEntry();
                addCategoryEntry();
            }
            updateCategoryTotals();
        } else {
            // Restore single category mode - clear split entries completely
            document.getElementById('category_id').setAttribute('required', 'required');
            document.getElementById('category-entries').innerHTML = '';
            categoryEntryCount = 0;
        }
        // Update Gift Aid intent when switching modes
        if (typeof updateGiftAidOnCategoryChange === 'function') {
            updateGiftAidOnCategoryChange();
        }
    } else if (type === 'cashbook') {
        cashbookSplitMode = !cashbookSplitMode;
        document.getElementById('simple-cashbook-section').classList.toggle('hidden', cashbookSplitMode);
        document.getElementById('split-cashbook-section').classList.toggle('hidden', !cashbookSplitMode);

        const cashBookSelect = document.getElementById('cash_book_id');
        if (cashbookSplitMode) {
            cashBookSelect.value = '';
            cashBookSelect.removeAttribute('required');
            if (cashbookEntryCount === 0) {
                addCashbookEntry();
                addCashbookEntry();
            }
            updateCashbookTotals();
        } else {
            // Restore single cashbook mode - clear split entries completely
            document.getElementById('cashbook-entries').innerHTML = '';
            cashbookEntryCount = 0;
        }
    }
    updateSplitMode();
}

