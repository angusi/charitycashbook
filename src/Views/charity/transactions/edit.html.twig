// Partial Gift Aid functionality
let suggestedGiftAidAmount = null;

function updateCategoryBreakdown() {
    const breakdown = document.getElementById('category-breakdown');
    const useSuggestedBtn = document.getElementById('use-suggested-btn');
    
    if (!breakdown) return;
    
    // Get selected categories and their amounts
    let categoryData = [];
    
    if (categorySplitMode) {
        // Split mode - get from entries
        const entries = document.querySelectorAll('#category-entries > div');
        entries.forEach(entry => {
            const select = entry.querySelector('select');
            const amountInput = entry.querySelector('input[type="number"]');
            if (select && amountInput && select.value) {
                const cat = categories.find(c => c.id == select.value);
                if (cat) {
                    categoryData.push({
                        name: cat.name,
                        amount: parseFloat(amountInput.value) || 0,
                        eligible: !!cat.giftaid_eligible_default
                    });
                }
            }
        });
    } else {
        // Simple mode - single category
        const catId = document.getElementById('category_id')?.value;
        const amount = parseFloat(document.getElementById('amount')?.value) || 0;
        if (catId) {
            const cat = categories.find(c => c.id == catId);
            if (cat) {
                categoryData.push({
                    name: cat.name,
                    amount: amount,
                    eligible: !!cat.giftaid_eligible_default
                });
            }
        }
    }
    
    // Only show breakdown if there are multiple categories with mixed eligibility
    const hasMultipleCategories = categoryData.length > 1;
    const hasMixedEligibility = categoryData.some(c => c.eligible) && categoryData.some(c => !c.eligible);
    
    if (hasMultipleCategories && hasMixedEligibility) {
        let html = '<p class="text-sm font-medium text-gray-700 mb-2">Category breakdown:</p>';
        let eligibleTotal = 0;
        
        categoryData.forEach(c => {
            const icon = c.eligible ? '✓' : '✗';
            const colorClass = c.eligible ? 'text-green-600' : 'text-gray-400';
            html += `<div class="flex justify-between text-sm py-1">
                <span><span class="${colorClass}">${icon}</span> ${escapeHtml(c.name)}</span>
                <span>£${c.amount.toFixed(2)}${c.eligible ? ' (eligible)' : ''}</span>
            </div>`;
            if (c.eligible) eligibleTotal += c.amount;
        });
        
        html += `<div class="flex justify-between text-sm font-medium pt-2 border-t border-gray-200 mt-2">
            <span>Suggested eligible amount:</span>
            <span class="text-green-600">£${eligibleTotal.toFixed(2)}</span>
        </div>`;
        
        breakdown.innerHTML = html;
        breakdown.classList.remove('hidden');
        if (useSuggestedBtn) useSuggestedBtn.classList.remove('hidden');
        suggestedGiftAidAmount = eligibleTotal;
    } else {
        breakdown.classList.add('hidden');
        if (useSuggestedBtn) useSuggestedBtn.classList.add('hidden');
        suggestedGiftAidAmount = null;
    }
}

function useSuggestedGiftAidAmount() {
    if (suggestedGiftAidAmount !== null) {
        document.getElementById('giftaid_amount').value = suggestedGiftAidAmount.toFixed(2);
        updateGiftAidTaxPreview();
        checkGiftAidChanged();
    }
}

function updateGiftAidTaxPreview() {
    const giftaidAmountInput = document.getElementById('giftaid_amount');
    const taxPreview = document.getElementById('giftaid-tax-preview');
    const taxAmount = document.getElementById('giftaid-tax-amount');
    
    if (!giftaidAmountInput || !taxPreview) return;
    
    const amount = parseFloat(giftaidAmountInput.value) || 0;
    if (amount > 0) {
        taxAmount.textContent = (amount * 0.25).toFixed(2);
        taxPreview.classList.remove('hidden');
    } else {
        taxPreview.classList.add('hidden');
    }
}

// Update breakdown when categories change
const categorySelect = document.getElementById('category_id');
if (categorySelect) {
    categorySelect.addEventListener('change', function() {
        if (partialGiftAidVisible) updateCategoryBreakdown();
    });
}

const amountInput = document.getElementById('amount');
if (amountInput) {
    amountInput.addEventListener('input', function() {
        if (partialGiftAidVisible) updateCategoryBreakdown();
    });
}

const giftaidAmountInput = document.getElementById('giftaid_amount');
if (giftaidAmountInput) {
    giftaidAmountInput.addEventListener('input', updateGiftAidTaxPreview);
}

// Track changed fields
const originalValues = {};
const trackedFields = [
    'transaction_date', 'amount', 'description', 'reference',
    'fund_id', 'category_id', 'cash_book_id',
    'donor_id', 'giftaid_eligibility_override', 'giftaid_amount'
];

// Store original values on load
trackedFields.forEach(fieldName => {
    const field = document.querySelector(`[name="${fieldName}"]`);
    if (field) {
        originalValues[fieldName] = field.value;
    }
});

// Also track checkboxes
document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    originalValues[cb.name] = cb.checked;
});

// Store original Gift Aid UI intent (Yes/No/Partial - not just the hidden field value)
// Determine from button states at page load
function getInitialGiftAidIntent() {
    if (giftaidNoBtn?.classList.contains('bg-red-600')) return 'not_eligible';
    if (giftaidPartialBtn?.classList.contains('bg-yellow-500')) return 'partial';
    if (giftaidYesBtn?.classList.contains('bg-green-600')) return 'eligible';
    return ''; // none selected
}
originalValues['_giftaid_ui_intent'] = getInitialGiftAidIntent();

function markFieldChanged(field, isChanged, labelOverride = null) {
    if (isChanged) {
        field.classList.add('ring-2', 'ring-amber-400');
    } else {
        field.classList.remove('ring-2', 'ring-amber-400');
    }
    
    // Find the label - either passed in or search for it
    let label = labelOverride;
    if (!label) {
        const container = field.closest('div');
        if (container) label = container.querySelector('label');
    }
    
    if (label) {
        const existingIndicator = label.querySelector('.modified-indicator');
        if (isChanged && !existingIndicator) {
            const indicator = document.createElement('span');
            indicator.className = 'modified-indicator text-xs text-amber-600 ml-2';
            indicator.textContent = '(modified)';
            label.appendChild(indicator);
        } else if (!isChanged && existingIndicator) {
            existingIndicator.remove();
        }
    }
}

function checkFieldChanged(field) {
    const name = field.name;
    if (!name || !(name in originalValues)) return;
    
    let isChanged;
    if (field.type === 'checkbox') {
        isChanged = field.checked !== originalValues[name];
    } else {
        isChanged = field.value !== originalValues[name];
    }
    
    markFieldChanged(field, isChanged);
}

// Add change listeners to all tracked fields
trackedFields.forEach(fieldName => {
    const field = document.querySelector(`[name="${fieldName}"]`);
    if (field) {
        field.addEventListener('change', () => checkFieldChanged(field));
        field.addEventListener('input', () => checkFieldChanged(field));
    }
});

document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
    cb.addEventListener('change', () => checkFieldChanged(cb));
});

// Special handling for donor (hidden field updated by selectDonor)
if (typeof selectDonor !== 'undefined') {
    const origSelectDonorForTracking = selectDonor;
    selectDonor = function(id, name) {
        origSelectDonorForTracking(id, name);
        // Mark the visible search input, not the hidden field
        const searchField = document.getElementById('donor_search');
        const donorField = document.getElementById('donor_id');
        if (searchField && donorField) {
            const isChanged = donorField.value !== originalValues['donor_id'];
            markFieldChanged(searchField, isChanged);
        }
    };
}

if (typeof clearDonor !== 'undefined') {
    const origClearDonorForTracking = clearDonor;
    clearDonor = function() {
        origClearDonorForTracking();
        const searchField = document.getElementById('donor_search');
        const donorField = document.getElementById('donor_id');
        if (searchField && donorField) {
            const isChanged = donorField.value !== originalValues['donor_id'];
            markFieldChanged(searchField, isChanged);
        }
    };
}

// Track Gift Aid toggle changes - mark the toggle button group
function checkGiftAidChanged() {
    // Compare UI intent (Yes/No/Partial), not just hidden field value
    const isChanged = giftaidIntent !== originalValues['_giftaid_ui_intent'];
    
    // Find the button group
    const buttonGroup = document.querySelector('[role="group"]');
    if (buttonGroup) {
        if (isChanged) {
            buttonGroup.classList.add('ring-2', 'ring-amber-400', 'rounded-md');
        } else {
            buttonGroup.classList.remove('ring-2', 'ring-amber-400', 'rounded-md');
        }
    }
    
    // Find the label
    const overrideInput = document.getElementById('giftaid_eligibility_override');
    const toggleContainer = overrideInput?.closest('.mb-4');
    const toggleLabel = toggleContainer?.querySelector('label');
    
    if (toggleLabel) {
        const existingIndicator = toggleLabel.querySelector('.modified-indicator');
        if (isChanged && !existingIndicator) {
            const indicator = document.createElement('span');
            indicator.className = 'modified-indicator text-xs text-amber-600 ml-2';
            indicator.textContent = '(modified)';
            toggleLabel.appendChild(indicator);
        } else if (!isChanged && existingIndicator) {
            existingIndicator.remove();
        }
    }
    
    // Also check giftaid_amount
    const amountField = document.getElementById('giftaid_amount');
    if (amountField) {
        const amountChanged = amountField.value !== (originalValues['giftaid_amount'] || '');
        const amountLabel = document.querySelector('label[for="giftaid_amount"]');
        markFieldChanged(amountField, amountChanged, amountLabel);
    }
}

// Also track giftaid_amount input
const giftaidAmountForTracking = document.getElementById('giftaid_amount');
if (giftaidAmountForTracking) {
    giftaidAmountForTracking.addEventListener('input', checkGiftAidChanged);
    giftaidAmountForTracking.addEventListener('change', checkGiftAidChanged);
}

{% endif %}
</script>
{% endblock %}
