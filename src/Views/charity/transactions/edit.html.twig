function updateFundTotals() {
    const target = parseFloat(document.getElementById('amount').value) || 0;
    const inputs = document.querySelectorAll('#fund-entries input[type="number"]');
    let total = 0;
    inputs.forEach(input => {
        total += parseFloat(input.value) || 0;
    });

    document.getElementById('fund-total').textContent = total.toFixed(2);
    document.getElementById('fund-target').textContent = target.toFixed(2);

    const remaining = target - total;
    const remainingEl = document.getElementById('fund-remaining');
    if (Math.abs(remaining) > 0.01) {
        remainingEl.textContent = ` (${remaining > 0 ? '+' : ''}${remaining.toFixed(2)} remaining)`;
        remainingEl.className = remaining > 0 ? 'text-orange-500' : 'text-red-500';
    } else {
        remainingEl.textContent = ' ✓';
        remainingEl.className = 'text-green-500';
    }
}

