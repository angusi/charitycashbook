// Donor search functionality
const donors = {{ donors|json_encode|raw }};
const donorSearch = document.getElementById('donor_search');
const donorDropdown = document.getElementById('donor-dropdown');
const donorIdInput = document.getElementById('donor_id');

function truncate(str, maxLen) {
    if (!str) return '';
    return str.length > maxLen ? str.substring(0, maxLen) + '...' : str;
}

function positionDropdown() {
    const rect = donorSearch.getBoundingClientRect();
    donorDropdown.style.left = rect.left + 'px';
    donorDropdown.style.top = (rect.bottom + 4) + 'px';
    donorDropdown.style.width = rect.width + 'px';
}

function showDropdown() {
    positionDropdown();
    donorDropdown.classList.remove('hidden');
}

function hideDropdown() {
    donorDropdown.classList.add('hidden');
}

function renderDonorResults(results) {
    if (results.length === 0) {
        donorDropdown.innerHTML = '<div class="px-3 py-2 text-sm text-gray-500">No donors found</div>';
    } else {
        donorDropdown.innerHTML = results.map(d => `
            <div class="donor-option px-3 py-2 hover:bg-gray-100 cursor-pointer" data-id="${d.id}" data-name="${escapeHtml(d.name)}">
                <div class="text-sm font-medium text-gray-900">
                    ${escapeHtml(d.name)}
                    ${d.has_active_declaration ? '<span class="text-green-600 ml-1">✓</span>' : ''}
                </div>
                ${d.notes ? `<div class="text-xs text-gray-500">${escapeHtml(truncate(d.notes, 60))}</div>` : ''}
            </div>
        `).join('');
    }
    showDropdown();
}

function filterDonors(query) {
    const q = query.toLowerCase().trim();
    if (q === '') {
        return donors.slice(0, 10);
    }
    return donors.filter(d =>
        d.name.toLowerCase().includes(q) ||
        (d.notes && d.notes.toLowerCase().includes(q))
    ).slice(0, 20);
}

function selectDonor(id, name) {
    donorIdInput.value = id;
    donorSearch.value = name;
    hideDropdown();
}

function clearDonor() {
    donorIdInput.value = '';
    donorSearch.value = '';
}

donorSearch.addEventListener('input', function() {
    const results = filterDonors(this.value);
    renderDonorResults(results);
});

donorSearch.addEventListener('focus', function() {
    const results = filterDonors(this.value);
    renderDonorResults(results);
});

donorSearch.addEventListener('blur', function() {
    // Delay hiding to allow click on option
    setTimeout(hideDropdown, 200);
});

donorSearch.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        hideDropdown();
    }
});

donorDropdown.addEventListener('click', function(e) {
    const option = e.target.closest('.donor-option');
    if (option) {
        selectDonor(option.dataset.id, option.dataset.name);
    }
});

// Clear if user empties the field
donorSearch.addEventListener('change', function() {
    if (this.value === '') {
        clearDonor();
    }
});

// Reposition on scroll/resize
window.addEventListener('scroll', function() {
    if (!donorDropdown.classList.contains('hidden')) {
        positionDropdown();
    }
}, true);
window.addEventListener('resize', function() {
    if (!donorDropdown.classList.contains('hidden')) {
        positionDropdown();
    }
});

// New Donor Modal
const newDonorModal = document.getElementById('new-donor-modal');

function toggleDeclarationOptions() {
    const checkbox = document.getElementById('new-donor-declaration');
    const options = document.getElementById('declaration-options');
    options.classList.toggle('hidden', !checkbox.checked);
}

function openNewDonorModal() {
    hideDropdown();
    newDonorModal.classList.remove('hidden');
    document.getElementById('new-donor-name').focus();
}

function closeNewDonorModal() {
    newDonorModal.classList.add('hidden');
    document.getElementById('new-donor-form').reset();
    document.getElementById('new-donor-error').classList.add('hidden');
    document.getElementById('declaration-options').classList.add('hidden');
}

async function submitNewDonor(event) {
    event.preventDefault();

    const submitBtn = document.getElementById('new-donor-submit');
    const errorDiv = document.getElementById('new-donor-error');

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating...';
    errorDiv.classList.add('hidden');

    const addDeclaration = document.getElementById('new-donor-declaration').checked;
    const declarationScope = document.querySelector('input[name="declaration_scope"]:checked');

    const data = {
        name: document.getElementById('new-donor-name').value,
        email: document.getElementById('new-donor-email').value,
        address_line1: document.getElementById('new-donor-address1').value,
        city: document.getElementById('new-donor-city').value,
        postcode: document.getElementById('new-donor-postcode').value,
        add_declaration: addDeclaration,
        covers_past: addDeclaration && declarationScope && declarationScope.value === 'past',
        csrf_token: '{{ csrf_token }}'
    };

    try {
        const response = await fetch('/charity/{{ charity.id }}/donors/quick-create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-CSRF-Token': '{{ csrf_token }}'
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
            // Add new donor to local array
            donors.push({
                id: result.donor.id,
                name: result.donor.name,
                notes: null,
                has_active_declaration: result.donor.has_declaration
            });

            // Select the new donor
            selectDonor(result.donor.id, result.donor.name);
            closeNewDonorModal();
        } else {
            errorDiv.textContent = result.error || 'Failed to create donor';
            errorDiv.classList.remove('hidden');
        }
    } catch (err) {
        errorDiv.textContent = 'An error occurred. Please try again.';
        errorDiv.classList.remove('hidden');
    }

    submitBtn.disabled = false;
    submitBtn.textContent = 'Create & Select';
}

// Close modal on Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !newDonorModal.classList.contains('hidden')) {
        closeNewDonorModal();
    }
});

// Gift Aid Intent Toggle
const giftaidOverrideInput = document.getElementById('giftaid_eligibility_override');
const giftaidYesBtn = document.getElementById('giftaid-yes-btn');
const giftaidNoBtn = document.getElementById('giftaid-no-btn');
const giftaidPartialBtn = document.getElementById('giftaid-partial-btn');
const giftaidDetailsSection = document.getElementById('giftaid-details-section');
const giftaidIntentHint = document.getElementById('giftaid-intent-hint');
const partialGiftAidSection = document.getElementById('partial-giftaid-section');

let giftaidIntent = null;

function resetGiftAidButtons() {
    giftaidNoBtn?.classList.remove('bg-red-600', 'text-white', 'border-red-600');
    giftaidNoBtn?.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
    giftaidPartialBtn?.classList.remove('bg-yellow-500', 'text-white', 'border-yellow-500');
    giftaidPartialBtn?.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
    giftaidYesBtn?.classList.remove('bg-green-600', 'text-white', 'border-green-600');
    giftaidYesBtn?.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
}

function setGiftAidIntent(intent) {
    if (!giftaidOverrideInput) return;
    
    giftaidIntent = intent;
    giftaidOverrideInput.value = (intent === 'partial') ? 'eligible' : intent;
    
    resetGiftAidButtons();
    
    // Update button styles
    if (intent === 'not_eligible') {
        giftaidNoBtn?.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        giftaidNoBtn?.classList.add('bg-red-600', 'text-white', 'border-red-600');
        giftaidDetailsSection?.classList.add('hidden');
        partialGiftAidSection?.classList.add('hidden');
        if (giftaidIntentHint) {
            giftaidIntentHint.textContent = 'This receipt will not be claimed for Gift Aid.';
            giftaidIntentHint.classList.remove('text-green-600', 'text-orange-600');
            giftaidIntentHint.classList.add('text-gray-500');
        }
    } else if (intent === 'partial') {
        giftaidPartialBtn?.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        giftaidPartialBtn?.classList.add('bg-yellow-500', 'text-white', 'border-yellow-500');
        giftaidDetailsSection?.classList.remove('hidden');
        partialGiftAidSection?.classList.remove('hidden');
        // Make amount required for partial
        const giftaidAmountInput = document.getElementById('giftaid_amount');
        if (giftaidAmountInput) giftaidAmountInput.required = true;
        updateCategoryBreakdown();
        updateGiftAidIntentHint();
    } else if (intent === 'eligible') {
        giftaidYesBtn?.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        giftaidYesBtn?.classList.add('bg-green-600', 'text-white', 'border-green-600');
        giftaidDetailsSection?.classList.remove('hidden');
        partialGiftAidSection?.classList.add('hidden');
        // Clear partial amount when switching to full and remove required
        const giftaidAmountInput = document.getElementById('giftaid_amount');
        if (giftaidAmountInput) {
            giftaidAmountInput.value = '';
            giftaidAmountInput.required = false;
        }
        updateGiftAidIntentHint();
    }
}

function updateGiftAidIntentHint() {
    if (!giftaidIntentHint || giftaidOverrideInput?.value !== 'eligible') return;
    
    const hasDonor = donorIdInput?.value !== '';
    const hasOneoff = document.querySelector('input[name="has_oneoff_declaration"]')?.checked;
    
    if (hasOneoff) {
        giftaidIntentHint.textContent = 'One-off declaration - eligible for Gift Aid.';
        giftaidIntentHint.classList.remove('text-orange-600', 'text-gray-500');
        giftaidIntentHint.classList.add('text-green-600');
    } else if (!hasDonor) {
        giftaidIntentHint.textContent = 'Select a donor to complete Gift Aid setup.';
        giftaidIntentHint.classList.remove('text-green-600', 'text-gray-500');
        giftaidIntentHint.classList.add('text-orange-600');
    } else {
        // Check if selected donor has declaration
        const selectedDonor = donors.find(d => d.id == donorIdInput.value);
        if (selectedDonor && selectedDonor.has_active_declaration) {
            giftaidIntentHint.textContent = 'Donor has valid declaration - eligible for Gift Aid.';
            giftaidIntentHint.classList.remove('text-orange-600', 'text-gray-500');
            giftaidIntentHint.classList.add('text-green-600');
        } else {
            giftaidIntentHint.textContent = 'Donor needs a Gift Aid declaration.';
            giftaidIntentHint.classList.remove('text-green-600', 'text-gray-500');
            giftaidIntentHint.classList.add('text-orange-600');
        }
    }
}

