{% extends "layouts/charity.html.twig" %}

{% block title %}Transaction - {{ charity.name }}{% endblock %}

{% block charity_content %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Transaction Details</h1>
            <p class="text-sm text-gray-500">{{ charity.name }}</p>
        </div>
        <div class="space-x-2">
            {% if permissions.transactions_edit and transaction.giftaid_status != 'claimed' %}
                <a href="/charity/{{ charity.id }}/transactions/{{ transaction.id }}/edit" 
                   class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Edit
                </a>
            {% endif %}
            <a href="/charity/{{ charity.id }}/transactions" 
               class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                Back to List
            </a>
        </div>
    </div>

    {% include 'components/flash.html.twig' %}

    <div class="bg-white rounded-lg shadow overflow-x-auto">
        <div class="px-6 py-4 border-b border-gray-200 {{ transaction.transaction_type == 'receipt' ? 'bg-green-50' : 'bg-red-50' }}">
            <div class="flex justify-between items-center">
                <span class="text-lg font-medium {{ transaction.transaction_type == 'receipt' ? 'text-green-700' : 'text-red-700' }}">
                    {{ transaction.transaction_type|upper }}
                </span>
                <span class="text-2xl font-bold {{ transaction.transaction_type == 'receipt' ? 'text-green-700' : 'text-red-700' }}">
                    £{{ transaction.amount|number_format(2) }}
                </span>
            </div>
        </div>
        
        <div class="px-6 py-4 space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <dt class="text-sm font-medium text-gray-500">Date</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ transaction.transaction_date }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Reference</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ transaction.reference ?: '-' }}</dd>
                </div>
            </div>

            <div>
                <dt class="text-sm font-medium text-gray-500">Description</dt>
                <dd class="mt-1 text-sm text-gray-900">{{ transaction.description }}</dd>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <dt class="text-sm font-medium text-gray-500">Fund</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {% if transaction.fund_entries|length > 1 %}
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800 mb-1">
                                Split across {{ transaction.fund_entries|length }} funds
                            </span>
                        {% endif %}
                        {{ transaction.fund_name }}
                    </dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Category</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ transaction.category_name }}</dd>
                </div>
            </div>

            {% if transaction.fund_entries|length > 1 %}
                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-gray-700 mb-2">Fund Allocation</h4>
                    <table class="min-w-full text-sm">
                        <tbody class="divide-y divide-gray-200">
                            {% for entry in transaction.fund_entries %}
                                <tr>
                                    <td class="py-1 text-gray-900">{{ entry.fund_name }}</td>
                                    <td class="py-1 text-right {{ entry.amount >= 0 ? 'text-green-600' : 'text-red-600' }}">
                                        £{{ entry.amount|abs|number_format(2) }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if transaction.cashbook_entries|length > 0 %}
                <div class="bg-gray-50 rounded-lg p-4">
                    <h4 class="text-sm font-medium text-gray-700 mb-2">Cash Book Entries</h4>
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="text-xs text-gray-500">
                                <th class="py-1 text-left">Cash Book</th>
                                <th class="py-1 text-right">Amount</th>
                                <th class="py-1 text-center">Reconciled</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for entry in transaction.cashbook_entries %}
                                <tr>
                                    <td class="py-1 text-gray-900">{{ entry.cash_book_name }}</td>
                                    <td class="py-1 text-right {{ entry.amount >= 0 ? 'text-green-600' : 'text-red-600' }}">
                                        £{{ entry.amount|abs|number_format(2) }}
                                    </td>
                                    <td class="py-1 text-center">
                                        {% if entry.is_reconciled %}
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">✓</span>
                                        {% else %}
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if transaction.transaction_type == 'receipt' %}
                <div class="border-t border-gray-200 pt-4">
                    <h3 class="text-sm font-medium text-gray-900 mb-3">Gift Aid Information</h3>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Status</dt>
                            <dd class="mt-1">
                                {% if transaction.giftaid_status == 'claimed' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Claimed</span>
                                {% elseif transaction.giftaid_status == 'eligible' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Eligible</span>
                                {% elseif transaction.giftaid_status == 'gasds' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">GASDS</span>
                                {% elseif transaction.giftaid_status == 'not_eligible' %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Not Eligible</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">N/A</span>
                                {% endif %}
                            </dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Donor</dt>
                            <dd class="mt-1 text-sm text-gray-900">
                                {% if transaction.donor_id %}
                                    <a href="/charity/{{ charity.id }}/donors/{{ transaction.donor_id }}" class="text-blue-600 hover:text-blue-800">
                                        {{ transaction.donor_name }}
                                    </a>
                                {% else %}
                                    Anonymous / Not specified
                                {% endif %}
                            </dd>
                        </div>
                    </div>
                    
                    {% if transaction.has_oneoff_declaration %}
                        <p class="mt-2 text-sm text-gray-600">
                            <svg class="inline h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            One-off Gift Aid declaration received
                        </p>
                    {% endif %}
                </div>
            {% endif %}

            <div class="border-t border-gray-200 pt-4 text-xs text-gray-500">
                <p>Created: {{ transaction.created_at }}</p>
                {% if transaction.updated_at != transaction.created_at %}
                    <p>Last updated: {{ transaction.updated_at }}</p>
                {% endif %}
            </div>
        </div>

        {% if permissions.transactions_delete and transaction.giftaid_status != 'claimed' %}
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200">
                <form id="delete-transaction-form" method="post" action="/charity/{{ charity.id }}/transactions/{{ transaction.id }}/delete">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="button" onclick="confirmAndSubmit('delete-transaction-form', 'Delete Transaction', 'Are you sure you want to delete this transaction? This cannot be undone.')" 
                            class="text-sm text-red-600 hover:text-red-800">
                        Delete Transaction
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
</div>

{% include 'components/confirm_modal.html.twig' %}
{% endblock %}
