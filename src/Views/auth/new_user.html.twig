{% extends "layouts/base.html.twig" %}

{% block title %}New Account - {{ app_name }}{% endblock %}

{% block content %}
<div class="flex items-center justify-center min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h1 class="text-center text-3xl font-extrabold text-gray-900">Welcome!</h1>
            <h2 class="mt-6 text-center text-xl text-gray-600">Create your account</h2>
        </div>
        
        <div class="bg-white shadow rounded-lg p-6">
            <p class="text-gray-700 mb-4">
                You're signing in with: <strong>{{ email }}</strong>
            </p>
            
            <p class="text-gray-600 mb-6">
                You have been authorised to access the following charities:
            </p>
            
            <ul class="list-disc list-inside mb-6 text-gray-700">
                {% for charity in charities %}
                <li>{{ charity.name }}</li>
                {% endfor %}
            </ul>
            
            <form action="/oauth/create-account" method="post" class="space-y-4">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                
                <button type="submit" 
                        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Create New Account
                </button>
            </form>
            
            {% if can_link %}
            <div class="mt-6 pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-600 mb-4">
                    Already have an account with a different email? You can link this login to your existing account.
                </p>
                <form action="/oauth/link-to-existing" method="post">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit"
                       class="w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Link to Existing Account
                    </button>
                </form>
            </div>
            {% endif %}
        </div>
        
        <p class="text-center">
            <a href="/login" class="text-indigo-600 hover:text-indigo-500">← Back to login</a>
        </p>
    </div>
</div>
{% endblock %}
