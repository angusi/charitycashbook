{% extends "layouts/base.html.twig" %}

{% block title %}Your Account - Charity Cashbook{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-6 px-4">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Your Account</h1>

    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Profile</h2>
        </div>
        <div class="px-6 py-4 space-y-4">
            <div>
                <dt class="text-sm font-medium text-gray-500">Name</dt>
                <dd class="mt-1 text-sm text-gray-900">{{ user.display_name }}</dd>
            </div>
            <div>
                <dt class="text-sm font-medium text-gray-500">Primary Email</dt>
                <dd class="mt-1 text-sm text-gray-900">{{ user.email }}</dd>
            </div>
            <div>
                <dt class="text-sm font-medium text-gray-500">Account Created</dt>
                <dd class="mt-1 text-sm text-gray-900">{{ user.created_at }}</dd>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-medium text-gray-900">Linked Identities</h2>
            <a href="/account/link" class="text-sm text-blue-600 hover:text-blue-800">+ Link Another Account</a>
        </div>
        <div class="divide-y divide-gray-200">
            {% for identity in identities %}
                <div class="px-6 py-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-gray-900">
                                {% if identity.provider_type == 'google' %}
                                    <svg class="inline h-5 w-5 mr-1" viewBox="0 0 24 24"><path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                                    Google
                                {% elseif identity.provider_type == 'microsoft' %}
                                    <svg class="inline h-5 w-5 mr-1" viewBox="0 0 21 21"><rect fill="#f25022" width="9" height="9"/><rect x="11" fill="#7fba00" width="9" height="9"/><rect y="11" fill="#00a4ef" width="9" height="9"/><rect x="11" y="11" fill="#ffb900" width="9" height="9"/></svg>
                                    Microsoft
                                {% else %}
                                    {{ identity.provider_type|capitalize }}
                                {% endif %}
                            </p>
                            <p class="text-sm text-gray-500">{{ identity.oauth_email }}</p>
                        </div>
                        <div class="text-sm text-gray-500">
                            Added {{ identity.created_at }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="px-6 py-4 text-center text-gray-500">
                    No identities linked
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-medium text-gray-900">Active Sessions</h2>
            <form method="post" action="/account/sessions/logout-all" 
                  onsubmit="return confirm('This will log you out of all devices. Continue?');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="text-sm text-red-600 hover:text-red-800">
                    Log Out All Sessions
                </button>
            </form>
        </div>
        <div class="divide-y divide-gray-200">
            {% for session in sessions %}
                <div class="px-6 py-4">
                    <div class="flex justify-between">
                        <div>
                            <p class="text-sm text-gray-900">
                                {{ session.user_agent|slice(0, 50) }}{% if session.user_agent|length > 50 %}...{% endif %}
                            </p>
                            <p class="text-xs text-gray-500">
                                IP: {{ session.ip_address }} · Last active: {{ session.last_activity_at }}
                            </p>
                        </div>
                        {% if session.is_current %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                Current
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
