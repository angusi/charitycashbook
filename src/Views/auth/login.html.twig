{% extends "layouts/base.html.twig" %}

{% block title %}{% if is_reauth %}Confirm Your Identity{% else %}Login{% endif %} - {{ app_name }}{% endblock %}

{% block content %}
<div class="flex items-center justify-center min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h1 class="text-center text-3xl font-extrabold text-gray-900">{{ app_name }}</h1>
            {% if is_reauth %}
            <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <h2 class="text-center text-lg font-semibold text-yellow-800">Identity Confirmation Required</h2>
                <p class="mt-2 text-center text-sm text-yellow-700">
                    To {{ reauth_context.description|default('perform this sensitive action') }}, please sign in again to confirm your identity.
                </p>
            </div>
            {% else %}
            <h2 class="mt-6 text-center text-xl text-gray-600">Sign in to your account</h2>
            {% endif %}
        </div>
        
        <div class="mt-8 space-y-4">
            {% for provider in providers %}
            <a href="/login/{{ provider.id }}" 
               class="group relative w-full flex justify-center py-3 px-4 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                {% if provider.provider_type == 'google' %}
                <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                {% if is_reauth %}Confirm with Google{% else %}Sign in with Google{% endif %}
                {% elseif provider.provider_type == 'microsoft' %}
                <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                    <path fill="#f25022" d="M1 1h10v10H1z"/>
                    <path fill="#00a4ef" d="M1 13h10v10H1z"/>
                    <path fill="#7fba00" d="M13 1h10v10H13z"/>
                    <path fill="#ffb900" d="M13 13h10v10H13z"/>
                </svg>
                {% if is_reauth %}Confirm with Microsoft{% else %}Sign in with Microsoft{% endif %}
                {% else %}
                {% if is_reauth %}Confirm with {{ provider.name }}{% else %}Sign in with {{ provider.name }}{% endif %}
                {% endif %}
            </a>
            {% else %}
            <p class="text-center text-gray-500">No login providers configured. Please contact the administrator.</p>
            {% endfor %}
            
            {% if is_reauth and reauth_context.cancel_url %}
            <div class="pt-4 border-t border-gray-200">
                <a href="{{ reauth_context.cancel_url }}" 
                   class="group relative w-full flex justify-center py-3 px-4 border border-gray-300 text-sm font-medium rounded-md text-gray-500 bg-gray-50 hover:bg-gray-100">
                    Cancel
                </a>
            </div>
            {% endif %}
        </div>
        
        {% if not is_reauth %}
        <p class="mt-8 text-center text-sm text-gray-600">
            Financial management for small charities
        </p>
        <p class="mt-2 text-center text-xs text-gray-400">
            By signing in, you agree to our 
            <a href="/terms" class="text-blue-600 hover:text-blue-800">Terms of Service</a>
            and
            <a href="/privacy" class="text-blue-600 hover:text-blue-800">Privacy Policy</a>
        </p>
        {% endif %}
    </div>
</div>
{% endblock %}
