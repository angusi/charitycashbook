{% extends "layouts/base.html.twig" %}

{% block title %}Gift Aid Declaration - {{ charity_name }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-lg shadow px-6 py-8 sm:px-10">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900">Gift Aid Declaration</h1>
            <p class="mt-2 text-sm text-gray-600">for <strong>{{ charity_name }}</strong></p>
        </div>

        {% if flash.error %}
            {% for message in flash.error %}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
                <span class="block sm:inline">{{ message }}</span>
            </div>
            {% endfor %}
        {% endif %}

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8">
            <h2 class="text-sm font-semibold text-blue-900 mb-2">What is Gift Aid?</h2>
            <p class="text-sm text-blue-800">
                Gift Aid is a UK tax incentive that allows charities to reclaim 25p for every £1 donated by a UK taxpayer.
                It doesn't cost you anything extra — the charity simply reclaims the basic rate tax you've already paid.
            </p>
        </div>

        <form method="post" action="/giftaid/declare/{{ token }}" class="space-y-6">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            {# HMRC-mandated declaration wording #}
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
                <p class="text-sm text-gray-900 font-medium mb-3">
                    I want to Gift Aid my donations and any donations I make in the future or have made in the past 4 years to:
                </p>
                <p class="text-sm text-gray-900 font-bold mb-4">{{ charity_name }}</p>
                <p class="text-sm text-gray-700">
                    I am a UK taxpayer and understand that if I pay less Income Tax and/or Capital Gains Tax than the amount
                    of Gift Aid claimed on all my donations in that tax year it is my responsibility to pay any difference.
                </p>
            </div>

            {# Taxpayer confirmation #}
            <div class="flex items-start">
                <div class="flex items-center h-5">
                    <input id="confirm_taxpayer" name="confirm_taxpayer" type="checkbox" value="1"
                           class="h-5 w-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500" required>
                </div>
                <label for="confirm_taxpayer" class="ml-3 text-sm font-medium text-gray-900">
                    I confirm I am a UK taxpayer and wish to make this Gift Aid declaration
                    <span class="text-red-500">*</span>
                </label>
            </div>

            {# Your details #}
            <fieldset class="space-y-4">
                <legend class="text-lg font-medium text-gray-900 border-b border-gray-200 pb-2 w-full">Your Details</legend>
                
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Full Name <span class="text-red-500">*</span></label>
                    <input type="text" name="name" id="name" value="{{ donor.name }}" required
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>

                <div>
                    <label for="address_line1" class="block text-sm font-medium text-gray-700">Address Line 1 <span class="text-red-500">*</span></label>
                    <input type="text" name="address_line1" id="address_line1" value="{{ donor.address_line1 }}" required
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>

                <div>
                    <label for="address_line2" class="block text-sm font-medium text-gray-700">Address Line 2</label>
                    <input type="text" name="address_line2" id="address_line2" value="{{ donor.address_line2 }}"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="address_city" class="block text-sm font-medium text-gray-700">City / Town</label>
                        <input type="text" name="address_city" id="address_city" value="{{ donor.address_city }}"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                    <div>
                        <label for="address_postcode" class="block text-sm font-medium text-gray-700">Postcode <span class="text-red-500">*</span></label>
                        <input type="text" name="address_postcode" id="address_postcode" value="{{ donor.address_postcode }}" required
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    </div>
                </div>
            </fieldset>

            {# Covers past donations #}
            <fieldset class="space-y-3">
                <legend class="text-lg font-medium text-gray-900 border-b border-gray-200 pb-2 w-full">Past Donations</legend>
                
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        <input id="covers_past" name="covers_past" type="checkbox" value="1"
                               class="h-5 w-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
                               onchange="document.getElementById('past_date_group').classList.toggle('hidden', !this.checked)">
                    </div>
                    <label for="covers_past" class="ml-3 text-sm text-gray-700">
                        I would also like this declaration to apply to donations I have made in the past 4 years
                    </label>
                </div>

                <div id="past_date_group" class="hidden ml-8">
                    <label for="covers_past_from_date" class="block text-sm font-medium text-gray-700">Apply from date (optional)</label>
                    <input type="date" name="covers_past_from_date" id="covers_past_from_date"
                           class="mt-1 block w-48 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">
                    <p class="mt-1 text-xs text-gray-500">Leave blank to cover all eligible past donations (up to 4 years).</p>
                </div>
            </fieldset>

            {# Important notes #}
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <h3 class="text-sm font-semibold text-yellow-900 mb-1">Please notify {{ charity_name }} if you:</h3>
                <ul class="text-sm text-yellow-800 list-disc list-inside space-y-1">
                    <li>Want to cancel this declaration</li>
                    <li>Change your name or home address</li>
                    <li>No longer pay sufficient Income Tax and/or Capital Gains Tax</li>
                </ul>
                <p class="text-xs text-yellow-700 mt-2">
                    If you pay Income Tax at the higher or additional rate and want to receive the additional tax relief due to you,
                    you must include all your Gift Aid donations on your Self-Assessment tax return or ask HM Revenue and Customs to adjust your tax code.
                </p>
            </div>

            <button type="submit"
                    class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Submit Gift Aid Declaration
            </button>
        </form>

        <p class="mt-6 text-center text-xs text-gray-400">
            Your data will be stored securely and used only for Gift Aid purposes.
            <a href="/privacy" class="underline hover:text-gray-600">Privacy Policy</a>
        </p>
    </div>
</div>
{% endblock %}
