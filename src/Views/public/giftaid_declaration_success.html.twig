{% extends "layouts/base.html.twig" %}

{% block title %}Declaration Submitted - {{ charity_name }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-lg shadow px-6 py-8 sm:px-10 text-center">
        <svg class="mx-auto h-16 w-16 text-green-500 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>

        <h1 class="text-2xl font-bold text-gray-900 mb-2">Thank You!</h1>
        <p class="text-gray-600 mb-6">
            Your Gift Aid declaration for <strong>{{ charity_name }}</strong> has been submitted successfully.
        </p>

        <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6 text-left">
            <h2 class="text-sm font-semibold text-green-900 mb-2">What happens next?</h2>
            <ul class="text-sm text-green-800 list-disc list-inside space-y-1">
                <li>Your declaration is now on file with {{ charity_name }}</li>
                <li>The charity can claim Gift Aid on your eligible donations</li>
                <li>You don't need to do anything else unless your circumstances change</li>
            </ul>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 text-left">
            <h3 class="text-sm font-semibold text-gray-900 mb-1">Remember to notify {{ charity_name }} if you:</h3>
            <ul class="text-sm text-gray-700 list-disc list-inside space-y-1">
                <li>Want to cancel this declaration</li>
                <li>Change your name or home address</li>
                <li>No longer pay sufficient Income Tax and/or Capital Gains Tax</li>
            </ul>
        </div>

        <p class="mt-8 text-xs text-gray-400">You can close this page now.</p>
    </div>
</div>
{% endblock %}
