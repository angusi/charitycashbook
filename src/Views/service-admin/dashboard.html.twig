{% extends "layouts/base.html.twig" %}

{% block title %}Service Admin - Charity Cashbook{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-6 px-4">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Service Administration</h1>
        <p class="text-sm text-gray-500">System overview and management</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-xs font-medium text-gray-500">Charities</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.charities_active }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-xs font-medium text-gray-500">Users</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.users_total }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-xs font-medium text-gray-500">Active Sessions</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.sessions_active }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-xs font-medium text-gray-500">Active Today</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.active_users_today }}</p>
        </div>
    </div>

    <!-- Security Alerts -->
    {% if security_alerts is not empty %}
    <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 rounded-r-lg">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3 flex-1">
                <h3 class="text-sm font-medium text-red-800">Security Alerts ({{ security_alerts|length }})</h3>
                <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc pl-5 space-y-1">
                        {% for alert in security_alerts[:3] %}
                            <li class="{{ alert.severity == 'high' ? 'font-semibold' : '' }}">
                                {{ alert.message }}
                            </li>
                        {% endfor %}
                        {% if security_alerts|length > 3 %}
                            <li>and {{ security_alerts|length - 3 }} more...</li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            <div class="ml-4">
                <a href="/service-admin/security" class="text-sm font-medium text-red-800 hover:text-red-900">
                    Investigate →
                </a>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Quick Actions -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-4 py-3 border-b border-gray-200">
            <h2 class="text-sm font-medium text-gray-900">Quick Actions</h2>
        </div>
        <div class="p-4 grid grid-cols-2 md:grid-cols-4 gap-3">
            <a href="/service-admin/charities/create" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                <span class="text-sm font-medium text-gray-900">New Charity</span>
            </a>
            <a href="/service-admin/charities" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Charities</span>
            </a>
            <a href="/service-admin/providers" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">OAuth Providers</span>
            </a>
            <a href="/service-admin/templates" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Templates</span>
            </a>
        </div>
    </div>

    <!-- Tools -->
    <div class="mt-6 bg-white rounded-lg shadow">
        <div class="px-4 py-3 border-b border-gray-200">
            <h2 class="text-sm font-medium text-gray-900">Tools</h2>
        </div>
        <div class="p-4 grid grid-cols-2 md:grid-cols-5 gap-3">
            <a href="/service-admin/statistics" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Statistics</span>
            </a>
            <a href="/service-admin/logs" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Logs</span>
            </a>
            <a href="/service-admin/maintenance" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Maintenance</span>
            </a>
            <a href="/service-admin/privacy" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Privacy</span>
            </a>
            <a href="/service-admin/security" class="flex flex-col items-center gap-2 p-4 rounded-lg border hover:bg-gray-50">
                <svg class="h-8 w-8 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span class="text-sm font-medium text-gray-900">Security</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}
