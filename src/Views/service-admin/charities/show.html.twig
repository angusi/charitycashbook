{% extends "layouts/base.html.twig" %}

{% block title %}{{ charity.name }} - Service Admin{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-6 px-4">
    <div class="mb-6 flex justify-between items-start">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">{{ charity.name }}</h1>
            <p class="text-sm text-gray-500">
                {% if charity.charity_number %}Charity No: {{ charity.charity_number }}{% endif %}
            </p>
        </div>
        <div class="flex space-x-2">
            <a href="/service-admin/charities/{{ charity.id }}/edit" class="px-4 py-2 border border-blue-300 rounded-md shadow-sm text-sm font-medium text-blue-700 bg-white hover:bg-blue-50">
                Edit
            </a>
            {% if charity.is_active %}
                <form method="post" action="/service-admin/charities/{{ charity.id }}/suspend">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="px-4 py-2 border border-red-300 rounded-md shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50">
                        Suspend
                    </button>
                </form>
            {% else %}
                <form method="post" action="/service-admin/charities/{{ charity.id }}/reactivate">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="px-4 py-2 border border-green-300 rounded-md shadow-sm text-sm font-medium text-green-700 bg-white hover:bg-green-50">
                        Reactivate
                    </button>
                </form>
            {% endif %}
            <a href="/service-admin/charities" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                Back to List
            </a>
        </div>
    </div>

    <!-- Status Badge -->
    <div class="mb-6">
        {% if charity.is_active %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">Active</span>
        {% else %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">Suspended</span>
        {% endif %}
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-sm font-medium text-gray-500">Users</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.user_count|default(0) }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-sm font-medium text-gray-500">Funds</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.account_count|default(0) }}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4">
            <p class="text-sm font-medium text-gray-500">Transactions</p>
            <p class="text-2xl font-semibold text-gray-900">{{ stats.transaction_count|default(0) }}</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Charity Details -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Details</h2>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <p class="text-sm font-medium text-gray-500">Charity Number</p>
                    <p class="text-sm text-gray-900">{{ charity.registration_number|default('-') }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">HMRC Reference</p>
                    <p class="text-sm text-gray-900">{{ charity.hmrc_reference|default('-') }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">Address</p>
                    <p class="text-sm text-gray-900 whitespace-pre-line">{{ charity.address|default('-') }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">Financial Year End</p>
                    <p class="text-sm text-gray-900">{{ charity.year_end_day|default(31) }} {{ ['', 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][charity.year_end_month|default(3)] }}</p>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-500">Created</p>
                    <p class="text-sm text-gray-900">{{ charity.created_at }}</p>
                </div>
            </div>
        </div>

        <!-- Users -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900">Users</h2>
                {% if users|length > 0 %}
                <form method="post" action="/service-admin/charities/{{ charity.id }}/force-reauth">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="px-3 py-1 bg-yellow-600 text-white rounded text-xs hover:bg-yellow-700">
                        Force Reauth All
                    </button>
                </form>
                {% endif %}
            </div>
            <div class="divide-y divide-gray-200">
                {% if users is empty %}
                    <div class="px-6 py-8 text-center text-gray-500">No users</div>
                {% else %}
                    {% for user in users %}
                        <div class="px-6 py-3 flex justify-between items-center">
                            <div>
                                <p class="text-sm font-medium text-gray-900">{{ user.display_name|default(user.email) }}</p>
                                <p class="text-xs text-gray-500">{{ user.email }}</p>
                            </div>
                            <div class="flex items-center space-x-2">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium 
                                    {% if user.role == 'admin' %}bg-purple-100 text-purple-800
                                    {% elseif user.role == 'standard' %}bg-blue-100 text-blue-800
                                    {% elseif user.role == 'readonly' %}bg-gray-100 text-gray-800
                                    {% elseif user.role == 'pending' %}bg-yellow-100 text-yellow-800
                                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                                    {{ user.role|capitalize }}
                                </span>
                                {% if user.role != 'admin' %}
                                <form method="post" action="/service-admin/charities/{{ charity.id }}/users/{{ user.user_id }}/make-admin">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="px-2 py-0.5 bg-purple-600 text-white rounded text-xs hover:bg-purple-700">
                                        Make Admin
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Allowed Emails & Invitation -->
    <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Send Invitation -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Send Invitation</h2>
            </div>
            <div class="p-6">
                <p class="text-sm text-gray-600 mb-4">Send an invitation email to a charity administrator with login instructions.</p>
                <form method="post" action="/service-admin/charities/{{ charity.id }}/invite" class="flex gap-2">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="email" name="email" required placeholder="admin@charity.org" 
                        class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm">
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium">
                        Send
                    </button>
                </form>
            </div>
        </div>

        <!-- Allowed Emails -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Allowed Login Emails</h2>
            </div>
            <div class="divide-y divide-gray-200">
                {% if allowed_emails is empty %}
                    <div class="px-6 py-8 text-center text-gray-500">No allowed emails configured</div>
                {% else %}
                    {% for email in allowed_emails %}
                        <div class="px-6 py-3 flex justify-between items-center">
                            <div class="flex items-center space-x-2">
                                <span class="text-sm text-gray-900">{{ email.email_pattern }}</span>
                                {% if email.pattern_type == 'domain' %}
                                    <span class="text-xs text-gray-500">(domain)</span>
                                {% endif %}
                            </div>
                            <div class="flex items-center space-x-3">
                                {% if email.user_id %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                        Registered{% if email.role %} · {{ email.role|capitalize }}{% endif %}
                                    </span>
                                {% elseif email.pattern_type == 'email' %}
                                    <span class="text-xs text-gray-400">Not registered</span>
                                    <form method="post" action="/service-admin/charities/{{ charity.id }}/invite" class="inline">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="email" value="{{ email.email_pattern }}">
                                        <button type="submit" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Send Invite</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Recent Logins -->
    <div class="mt-6 bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Recent Logins</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Provider</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% if recent_logins is empty %}
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-gray-500">No login history</td>
                        </tr>
                    {% else %}
                        {% for login in recent_logins %}
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ login.oauth_email }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ login.provider_type|default('-') }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ login.ip_address }}</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if login.success %}
                                        <span class="text-xs text-green-600">Success</span>
                                    {% else %}
                                        <span class="text-xs text-red-600">Failed</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ login.created_at }}</td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
