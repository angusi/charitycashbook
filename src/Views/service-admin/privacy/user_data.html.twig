{% extends "layouts/base.html.twig" %}

{% block title %}User Data - {{ user_data.account.display_name }} - Service Admin{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-6 px-4">
    <div class="mb-6">
        <div class="flex items-center space-x-2 text-sm text-gray-500 mb-2">
            <a href="/service-admin/privacy" class="hover:text-gray-700">Privacy & Data Management</a>
            <span>›</span>
            <span>User Data</span>
        </div>
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{{ user_data.account.display_name }}</h1>
                <p class="text-sm text-gray-500">{{ user_data.account.primary_email }}</p>
            </div>
            <div class="space-x-2">
                <a href="/service-admin/privacy/users/{{ user_data.account.id }}/export" 
                   class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium">
                    Export Data (ZIP)
                </a>
                <a href="/service-admin/privacy/users/{{ user_data.account.id }}/delete" 
                   class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 text-sm font-medium">
                    Delete Account
                </a>
            </div>
        </div>
    </div>

    {% include 'components/flash.html.twig' %}

    <!-- Account Info -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Account Information</h2>
        </div>
        <div class="px-6 py-4">
            <dl class="grid grid-cols-2 gap-4">
                <div>
                    <dt class="text-sm font-medium text-gray-500">User ID</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ user_data.account.id }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Status</dt>
                    <dd class="mt-1">
                        {% if user_data.account.is_active %}
                            <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Active</span>
                        {% else %}
                            <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">Inactive</span>
                        {% endif %}
                    </dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Role</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ user_data.account.is_super_admin ? 'Super Admin' : 'User' }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Created</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ user_data.account.created_at }}</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Identities -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Linked Identities ({{ user_data.identities|length }})</h2>
        </div>
        {% if user_data.identities is empty %}
        <div class="px-6 py-4 text-center text-gray-500">No linked identities</div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Provider</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Verified</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Linked</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for identity in user_data.identities %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ identity.provider_name }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ identity.oauth_email }}</td>
                        <td class="px-6 py-4">
                            {% if identity.is_verified %}
                                <span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">Verified</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ identity.created_at }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Charity Access -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Charity Access ({{ user_data.charity_access|length }})</h2>
        </div>
        {% if user_data.charity_access is empty %}
        <div class="px-6 py-4 text-center text-gray-500">No charity access</div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Charity</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Granted</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for access in user_data.charity_access %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ access.charity_name ?: 'Charity #' ~ access.charity_id }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ access.role }}</td>
                        <td class="px-6 py-4">
                            {% if access.is_active %}
                                <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Active</span>
                            {% else %}
                                <span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">Inactive</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ access.created_at }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Login History -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Recent Login History ({{ user_data.login_history|length }})</h2>
        </div>
        {% if user_data.login_history is empty %}
        <div class="px-6 py-4 text-center text-gray-500">No login history</div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date/Time</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User Agent</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for login in user_data.login_history %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ login.created_at }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500 font-mono">{{ login.ip_address }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">{{ login.user_agent }}</td>
                        <td class="px-6 py-4">
                            {% if login.success %}
                                <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Success</span>
                            {% else %}
                                <span class="px-2 py-1 text-xs rounded-full bg-red-100 text-red-800">Failed</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Sessions -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-medium text-gray-900">Active Sessions ({{ user_data.sessions|length }})</h2>
            {% if user_data.sessions|length > 0 %}
            <form id="terminate-user-sessions-form" method="post" action="/service-admin/privacy/users/{{ user_data.account.id }}/terminate-sessions">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="button" class="px-3 py-1 bg-red-600 text-white rounded text-sm hover:bg-red-700" onclick="showConfirmModal('Terminate Sessions', 'Terminate all sessions for this user? They will be logged out immediately.', function() { document.getElementById('terminate-user-sessions-form').submit(); })">
                    Terminate All Sessions
                </button>
            </form>
            {% endif %}
        </div>
        {% if user_data.sessions is empty %}
        <div class="px-6 py-4 text-center text-gray-500">No active sessions</div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Session ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Created</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expires</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for session in user_data.sessions %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900 font-mono">#{{ session.id }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500 font-mono">{{ session.ip_address }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ session.created_at }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ session.expires_at }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Audit Log -->
    <div class="bg-white rounded-lg shadow mb-6">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Recent Audit Log ({{ user_data.audit_log|length }})</h2>
        </div>
        {% if user_data.audit_log is empty %}
        <div class="px-6 py-4 text-center text-gray-500">No audit log entries</div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date/Time</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Entity</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for entry in user_data.audit_log %}
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-900">{{ entry.created_at }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ entry.action }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ entry.entity_type ~ '#' ~ entry.entity_id }}</td>
                        <td class="px-6 py-4 text-sm text-gray-500 font-mono">{{ entry.ip_address }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <div class="text-center">
        <a href="/service-admin/privacy" class="text-sm text-blue-600 hover:text-blue-800">&larr; Back to Privacy Search</a>
    </div>
</div>
{% include 'components/confirm_modal.html.twig' %}
{% endblock %}
