{% extends "layouts/base.html.twig" %}

{% block title %}Maintenance - Service Admin{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto py-6 px-4">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">System Maintenance</h1>
        <p class="text-sm text-gray-500">Cache management and cleanup tasks</p>
    </div>

    {% include 'components/flash.html.twig' %}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Cache Management -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Template Cache</h2>
            </div>
            <div class="p-6">
                <div class="space-y-3 mb-4">
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Cached Files</span>
                        <span class="text-sm font-medium text-gray-900">{{ stats.cache_files }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Cache Size</span>
                        <span class="text-sm font-medium text-gray-900">{{ stats.cache_size }}</span>
                    </div>
                </div>
                <form method="post" action="/service-admin/maintenance/clear-cache" onsubmit="return confirm('Clear all cached templates?');">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium">
                        Clear Template Cache
                    </button>
                </form>
                <p class="mt-2 text-xs text-gray-500">Compiled Twig templates will be regenerated on next request.</p>
            </div>
        </div>

        <!-- Session Cleanup -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Sessions</h2>
            </div>
            <div class="p-6">
                <div class="space-y-3 mb-4">
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Active Sessions</span>
                        <span class="text-sm font-medium text-green-600">{{ stats.active_sessions }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Expired Sessions</span>
                        <span class="text-sm font-medium {% if stats.expired_sessions > 0 %}text-amber-600{% else %}text-gray-900{% endif %}">{{ stats.expired_sessions }}</span>
                    </div>
                </div>
                <form method="post" action="/service-admin/maintenance/clean-sessions">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium {% if stats.expired_sessions == 0 %}opacity-50 cursor-not-allowed{% endif %}" {% if stats.expired_sessions == 0 %}disabled{% endif %}>
                        Clean Expired Sessions
                    </button>
                </form>
                <p class="mt-2 text-xs text-gray-500">Remove expired session records from the database.</p>
            </div>
        </div>

        <!-- Pending Links Cleanup -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Pending Identity Links</h2>
            </div>
            <div class="p-6">
                <div class="space-y-3 mb-4">
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Expired Tokens</span>
                        <span class="text-sm font-medium {% if stats.expired_tokens > 0 %}text-amber-600{% else %}text-gray-900{% endif %}">{{ stats.expired_tokens }}</span>
                    </div>
                </div>
                <form method="post" action="/service-admin/maintenance/clean-tokens">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm font-medium {% if stats.expired_tokens == 0 %}opacity-50 cursor-not-allowed{% endif %}" {% if stats.expired_tokens == 0 %}disabled{% endif %}>
                        Clean Expired Tokens
                    </button>
                </form>
                <p class="mt-2 text-xs text-gray-500">Remove expired account linking tokens.</p>
            </div>
        </div>

        <!-- Log Files -->
        <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-lg font-medium text-gray-900">Log Files</h2>
            </div>
            <div class="p-6">
                <div class="space-y-3 mb-4">
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Log Files</span>
                        <span class="text-sm font-medium text-gray-900">{{ stats.log_files }}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-sm text-gray-500">Total Size</span>
                        <span class="text-sm font-medium text-gray-900">{{ stats.log_size }}</span>
                    </div>
                </div>
                <a href="/service-admin/logs" class="block w-full px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 text-sm font-medium text-center">
                    View Logs
                </a>
            </div>
        </div>
    </div>

    <!-- Audit Log Stats -->
    <div class="mt-6 bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Audit Log</h2>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-2 gap-4">
                <div class="flex justify-between">
                    <span class="text-sm text-gray-500">Total Entries</span>
                    <span class="text-sm font-medium text-gray-900">{{ stats.audit_log_total|number_format }}</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-sm text-gray-500">Entries &gt; 7 years old</span>
                    <span class="text-sm font-medium {% if stats.audit_log_old > 0 %}text-amber-600{% else %}text-gray-900{% endif %}">{{ stats.audit_log_old|number_format }}</span>
                </div>
            </div>
            <p class="mt-4 text-xs text-gray-500">
                To clean old audit logs, use the CLI: <code class="bg-gray-100 px-1 rounded">php cli/maintenance.php clean-logs --older-than=7years</code>
            </p>
        </div>
    </div>

    <!-- Force Re-authentication -->
    <div class="mt-6 bg-white rounded-lg shadow border-2 border-red-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-red-50">
            <h2 class="text-lg font-medium text-red-900">Force Re-authentication</h2>
        </div>
        <div class="p-6">
            <p class="text-sm text-gray-600 mb-4">
                Force all users to log in again by terminating their sessions. Use this after a security incident or when deploying permission changes that require immediate effect.
            </p>
            <div class="bg-yellow-50 border border-yellow-200 rounded-md p-3 mb-4">
                <p class="text-sm text-yellow-800">
                    <strong>Warning:</strong> This will immediately log out all {{ stats.active_sessions }} active users (except yourself). They will need to sign in again.
                </p>
            </div>
            <form method="post" action="/service-admin/maintenance/force-global-reauth" onsubmit="return confirm('Are you sure you want to force ALL users to re-authenticate? This will terminate {{ stats.active_sessions }} active sessions.');">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="w-full px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 text-sm font-medium">
                    Force Global Re-authentication
                </button>
            </form>
            <p class="mt-3 text-xs text-gray-500">
                To force re-authentication for a specific charity's users, go to the charity's detail page.
            </p>
        </div>
    </div>

    <div class="mt-6 text-center">
        <a href="/service-admin" class="text-sm text-blue-600 hover:text-blue-800">&larr; Back to Dashboard</a>
    </div>
</div>
{% endblock %}
