{% extends "layouts/base.html.twig" %}

{% block header %}
{% if user %}
<header class="bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
        <div class="flex items-center space-x-4">
            <a href="/charity/{{ charity.id }}" class="text-lg font-semibold text-gray-900">{{ charity.name }}</a>
        </div>
        <div class="flex items-center space-x-4">
            <a href="/charities" class="text-sm text-gray-600 hover:text-gray-800">Switch Charity</a>
            {% if user.is_super_admin %}
            <a href="/service-admin" class="text-sm text-blue-600 hover:text-blue-800">Service Admin</a>
            {% endif %}
            <a href="/account" class="text-sm text-gray-600 hover:text-gray-800">Account</a>
            <a href="/logout" class="text-sm text-red-600 hover:text-red-800">Logout</a>
        </div>
    </div>
    <!-- Charity Navigation -->
    <nav class="bg-gray-50 border-t border-gray-200">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex space-x-6 overflow-x-auto">
                <a href="/charity/{{ charity.id }}" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'dashboard' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Dashboard
                </a>
                <a href="/charity/{{ charity.id }}/transactions" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'transactions' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Transactions
                </a>
                <a href="/charity/{{ charity.id }}/funds" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'funds' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Funds
                </a>
                <a href="/charity/{{ charity.id }}/categories" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'categories' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Categories
                </a>
                {% if enabled_modules is not defined or (enabled_modules.donors is defined and enabled_modules.donors.is_enabled) %}
                <a href="/charity/{{ charity.id }}/donors" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'donors' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Donors
                </a>
                {% endif %}
                {% if enabled_modules.members is defined and enabled_modules.members.is_enabled %}
                <a href="/charity/{{ charity.id }}/members" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'members' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Members
                </a>
                {% endif %}
                {% if enabled_modules is not defined or (enabled_modules.reports is defined and enabled_modules.reports.is_enabled) %}
                <a href="/charity/{{ charity.id }}/reports" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'reports' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Reports
                </a>
                {% endif %}
                {% if (enabled_modules is not defined or (enabled_modules.giftaid is defined and enabled_modules.giftaid.is_enabled)) and permissions.giftaid_view %}
                <a href="/charity/{{ charity.id }}/giftaid" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'giftaid' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Gift Aid
                </a>
                {% endif %}
                {% if enabled_modules.cashbooks is defined and enabled_modules.cashbooks.is_enabled %}
                <a href="/charity/{{ charity.id }}/cashbooks" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'cashbooks' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Cash Books
                </a>
                {% endif %}
                {% if permissions.settings_view %}
                <a href="/charity/{{ charity.id }}/settings" 
                   class="py-3 px-1 text-sm font-medium border-b-2 {{ active_nav == 'settings' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                    Settings
                </a>
                {% endif %}
            </div>
        </div>
    </nav>
</header>
{% endif %}
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto py-6 px-4">
    {% block charity_content %}{% endblock %}
</div>
{% endblock %}
